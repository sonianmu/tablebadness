  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "编号、负责人、状态和日期均保持单行，结构化字段紧凑，便于纵向扫描；说明列占据主要空间，长句自然分行，每条任务仍清楚地横向成行。",
     "problems": "部分说明的末行较短，视觉上略有参差。",
     "cause": "说明列为424px，长句在这一宽度下需要两行；其余列已接近保持内容单行所需的宽度，难以再为说明列腾出有意义的空间。"
    },
    {
     "design": "r0B",
     "good": "各字段和表头均保持单行，列间留白充裕，任务信息容易辨认。",
     "problems": "负责人、状态和日期列显得过宽，说明列相对局促；长说明更早换行，但表格总高度没有减少。",
     "cause": "前三个结构化信息列之外，负责人和状态各分配90px、日期分配132px，使说明列缩至339px。"
    },
    {
     "design": "r0C",
     "good": "说明列最宽，叙述内容有较充裕的阅读空间。",
     "problems": "截止日期表头和所有日期均被拆成两行，破坏日期的整体识别和纵向比较；因此每行都变高，短说明旁出现大量空白。",
     "cause": "日期列只有75px，扣除21px边距和边框后仅剩54px，无法容纳单行表头和日期；说明列增至457px并未抵消日期换行带来的高度增加。"
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
