 "understanding": {
  "purpose": "按费用项目和员工职级查阅公司差旅报销标准。",
  "reading": "读者先沿首列找到费用项目，再横向比较普通员工、经理和总监的标准；也可能沿某一职级向下查阅各项规定。",
  "groups": [
   "第 2、3、4 列都是职级对应的报销标准，应便于横向比较。",
   "第 1 列是费用项目标签，用来识别和区分各行。"
  ],
  "keep_intact": [
   "金额、计量单位和数字应尽量保持在一起，例如“500 元/晚”和“80 元/日”。",
   "职级表头和费用项目名称应尽量完整，避免拆散难以辨认的词语。"
  ],
  "may_wrap": [
   "包含早餐、预订或改签条件等说明可在自然语义边界换行。",
   "同一行中较长标准造成的行高可容纳其他职级标准的换行。"
  ]
