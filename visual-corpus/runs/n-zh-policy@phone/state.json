  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "唯一没有任何表头折行的方案：四列表头都保持一行，表格高度为 498px，行高为 83–106px，扫描节奏稳定；首列 89px 让“费用项目”完整显示，行标签按“一线城市/住宿”自然断在语义边界；没有出现单词中间断开的情况。",
     "problems": "三个数据列（列 2、3、4）全部把金额和单位拆开：“500 元/”和“晚，含早餐”、“700 元/”和“晚，含早 餐”、“120 元/”和“日限额”，全表出现 5 处以上；读者读到“元/”后会停顿，横向比较各职级金额时最关键的数值被拆散。另外，列 4 的“1000 元/晚”也断成“1000 元/”和“晚，凭票报销”。",
     "cause": "列宽均为 90px，去掉内边距和边框后只剩 69px 文本宽，而“500 元/晚”约需 70px，刚好差 1–2px；同时首列 89px 比实际所需多出 8px。列 1 的标签需要 111px 才能排成一行，而 81–110px 之间的任何宽度都只能得到同样的“4 字+2 字”断行，因此多出来的宽度完全浪费。"
    },
    {
     "design": "r0B",
     "good": "把宽度让给右侧两列（99px），方向正确：列 4 的“1000 元/晚”已接近不拆行，表格总高仍是 498px，行高分配与 r0A 相同，整体紧凑。",
     "problems": "首列 75px（文本区 54px）不足以放下“费用项目”这四个字（60px），表头断成“费用项/目”，使全表表头风格不一致（4 个表头中有 1 个折行）；行标签也被挤成“一线城/市住宿”“市内交/通”，断行位置比 r0A 更差；列 2 变成 86px 后，“500 元/”照样断开。也就是说，从首列挪走的 14px 没有换来任何收益。",
     "cause": "首列 75px 低于 81px 的最低门槛（60px 文本加 21px 内边距），而 99px 的列 3 和列 4 仍低于各自真正需要的阈值（“700 元/晚”约需 92px，“1000 元/晚”约需 101px）；宽度分给了无法达到阈值的列，首列却因此受损。"
    },
    {
     "design": "r0C",
     "good": "首列 113px 让所有行标签和表头都排成一行，“一线城市住宿”“其他城市住宿”完整显示，行识别最清楚，第一列的标签作用表达得最明确。",
     "problems": "数据列被压到 82px（文本区 61px）后，文字严重破碎：表头“普通员/工”折行，“500 元/晚，含早餐”被切成 3 行，还出现“经济/舱”“商务/座”这类 2 字断行，“据实报/销”也被拆开；最高单元格达到 5 行，表格高度增加到 614px，比 r0A 高 116px。首列成为最宽列，但它承载的信息最少，比例因此完全颠倒。",
     "cause": "为了把 6 字标签排成一行，首列需要 111px，因此多花了约 30px；这 30px 从三列数据列中扣除，使它们降到 61px，低于金额完整显示的门槛（约 70px），也低于每行容纳 3–4 个汉字的舒适宽度，于是行高连锁上升。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
 },
