  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "तीनों लिपियों के नाम और दूरी एक पंक्ति में हैं। टिप्पणी को अधिकतम उपलब्ध जगह मिलती है, जिससे लंबी टिप्पणियाँ स्वाभाविक रूप से लिपटती हैं और हर पंक्ति एक इकाई की तरह पढ़ी जाती है।",
     "problems": "अंतिम टिप्पणी चार पंक्तियों में है, जिससे उसके साथ वाले छोटे नामों और दूरी के नीचे खाली जगह बनती है। उपलब्ध चौड़ाई में यह असंतुलन सामग्री की लंबाई के कारण है।",
     "cause": "पहले चार स्तंभ अपने सबसे चौड़े एक-पंक्ति पाठ और पैडिंग के लिए आवश्यक चौड़ाई पर हैं; टिप्पणी का 250px स्तंभ शेष जगह लेता है।"
    },
    {
     "design": "r0B",
     "good": "सभी शीर्षक और नाम एक पंक्ति में हैं; टिप्पणी में भी कोई शब्द बीच से नहीं टूटता।",
     "problems": "नामों के स्तंभों में अतिरिक्त खाली जगह है, जबकि टिप्पणी अधिक सघन लगती है। इसके बावजूद पंक्ति की ऊँचाई r0A जैसी ही रहती है।",
     "cause": "पहले तीन स्तंभों को r0A से कुल 38px अधिक देने पर टिप्पणी का स्तंभ 212px रह जाता है।"
    },
    {
     "design": "r0C",
     "good": "टिप्पणी को 255px मिलते हैं और उसके शब्द अक्षुण्ण रहते हैं; नाम और दूरी के मान भी साफ पढ़े जाते हैं।",
     "problems": "दूरी का शीर्षक दो पंक्तियों में टूटकर हेडर को अनावश्यक रूप से ऊँचा करता है। टिप्पणी में केवल 5px की वृद्धि से किसी पंक्ति की ऊँचाई कम नहीं होती।",
     "cause": "दूरी का 70px स्तंभ शीर्षक की 63px पाठ-चौड़ाई और 21px पैडिंग के लिए पर्याप्त नहीं है।"
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
