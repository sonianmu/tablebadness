  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "योजनाओं के नाम एक पंक्ति में हैं, वर्ष और लाभार्थी साथ-साथ आसानी से स्कैन होते हैं, और विवरण में शब्द सुरक्षित हैं।",
     "problems": "पहले विवरण की दूसरी पंक्ति छोटी है; बाकी दो विवरणों के बाद पर्याप्त खाली जगह है।",
     "cause": "योजना के लिए 154px नाम को पूरा रखने के लिए आवश्यक है, जबकि विवरण के 416px में सबसे लंबा वाक्य दो असमान पंक्तियों में बँटता है।"
    },
    {
     "design": "r0B",
     "good": "वर्ष और लाभार्थी संक्षिप्त और साथ हैं। विवरण को अधिक जगह मिलने से उसका पहला वाक्य अपेक्षाकृत देर से टूटता है।",
     "problems": "पहली योजना का नाम दो पंक्तियों में बँटता है और उसकी दूसरी पंक्ति छोटी है; अतिरिक्त विवरण-चौड़ाई अन्य पंक्तियों में अधिक खाली जगह छोड़ती है।",
     "cause": "योजना को 105px देने से पूरे नाम के लिए जगह नहीं बचती; वहाँ से बचाए गए 49px विवरण को मिलते हैं, लेकिन सबसे लंबा विवरण फिर भी दो पंक्तियों में रहता है।"
    },
    {
     "design": "r0C",
     "good": "वर्ष और लाभार्थी स्तंभों में खुली जगह है और सभी तथ्य अक्षुण्ण हैं। पहली पंक्ति में नाम और विवरण दोनों का लपेटना पंक्ति को एक इकाई की तरह रखता है।",
     "problems": "पहले नाम में केवल अंतिम शब्द दूसरी पंक्ति पर जाता है। तथ्य वाले स्तंभों की अतिरिक्त खाली जगह विवरण की कीमत पर आती है और उसकी दूसरी पंक्ति भी छोटी रहती है।",
     "cause": "योजना के 130px पूरे नाम के लिए कम हैं; शुरुआत और लाभार्थी के 75px और 105px उनकी सामग्री से अधिक चौड़े हैं, जिससे विवरण को 409px मिलते हैं।"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "योजना के नाम, वर्ष और लाभार्थियों की संख्याएँ एक-एक पंक्ति में हैं। पहले विवरण की दो पंक्तियाँ पढ़ने योग्य हैं और बाकी पंक्तियाँ सघन हैं।",
     "problems": "वर्ष और लाभार्थी शीर्षक तथा उनके मान किनारों के अपेक्षाकृत पास हैं; विवरण की दूसरी पंक्ति छोटी है।",
     "cause": "शुरुआत के 66px और लाभार्थी के 83px उनके एक-पंक्ति पाठ के लिए न्यूनतम चौड़ाई हैं; विवरण को 416px मिलता है।"
    },
    {
     "design": "r1B",
     "good": "विवरण को अधिक जगह मिलती है और उसके शब्द तथा संख्याएँ अखंड रहते हैं।",
     "problems": "पहली योजना का नाम दो पंक्तियों में टूटता है, जिससे पहचान के लिए उसे स्कैन करना थोड़ा कठिन होता है। विवरण फिर भी दो पंक्तियों में है, इसलिए नाम से ली गई जगह पंक्ति की ऊँचाई नहीं घटाती।",
     "cause": "योजना की 135px चौड़ाई में 114px पाठ-स्थान है, जो पूरे नाम की 133px एक-पंक्ति चौड़ाई से कम है; विवरण के 435px भी उसे एक पंक्ति में लाने के लिए पर्याप्त नहीं हैं।"
    },
    {
     "design": "r1C",
     "good": "सभी नाम और संक्षिप्त तथ्य एक पंक्ति में रहते हैं। वर्ष और लाभार्थी स्तंभों में थोड़ी अधिक साँस लेने की जगह है और दोनों तथ्य साथ स्कैन होते हैं।",
     "problems": "पहले विवरण की दूसरी पंक्ति छोटी है, लेकिन उसकी वाक्यगत लय स्वाभाविक है। समग्र तालिका में कोई स्पष्ट टूटन या असंतुलन नहीं दिखता।",
     "cause": "वर्ष और लाभार्थी को क्रमशः 70px और 87px देने से विवरण के लिए 408px बचते हैं; यह पहले विवरण को दो पंक्तियों में रखता है।"
    }
   ],
   "done": true,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
