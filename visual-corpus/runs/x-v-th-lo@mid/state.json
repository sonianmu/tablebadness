  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "The paired name columns have equal visual weight, prices align on one line, and all headers remain intact. The short second row is easy to scan.",
     "problems": "The first and third descriptions occupy three lines, making those rows tall and leaving substantial empty space beneath the shorter names and prices.",
     "cause": "The 180px description column has only 159px for text. The 110px and 111px name columns take space that could help the longer descriptions."
    },
    {
     "design": "r0B",
     "good": "This is the strongest overall balance: descriptions fit within two lines, prices remain intact, and the similar name-column widths reinforce the Thai–Lao pairing. Rows are compact while still reading as units.",
     "problems": "The longest Thai and Lao dish names wrap, making the last row's name area feel noticeably tighter than the description area. The wide description column also leaves unused space in the short middle row.",
     "cause": "The 88px and 89px name columns provide only 67px and 68px of text width. The 224px description column receives much of the available space."
    },
    {
     "design": "r0C",
     "good": "The wider paired name columns let the longest dish names stay on one line, and prices and headers remain intact.",
     "problems": "Descriptions feel cramped and dominate the row heights. Even the short middle description wraps, while the first and last rows have large areas of empty space under their names and prices.",
     "cause": "The 148px description column leaves only 127px for text, while the 126px and 127px name columns consume more width than most names need."
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "The Thai and Lao names have balanced weight, prices align on one line, and the description has enough space to keep the rows relatively compact. Headers and words remain intact.",
     "problems": "Both names in the last row wrap, making that dish harder to scan across the paired columns. The description also wraps in the first and last rows.",
     "cause": "The 94px and 95px name columns provide 73px and 74px of text space, less than the widest names need. The 212px description column cannot hold the longest descriptions on one line."
    },
    {
     "design": "r1B",
     "good": "The paired name columns remain balanced, prices stay intact, and the row heights match r1A. The slightly wider name columns give the names more breathing room.",
     "problems": "The last-row names still wrap, so the extra width does not visibly resolve the main limitation of r1A. The narrower description column also leaves less room for descriptions.",
     "cause": "At 100px and 101px, the name columns still fall short of the 126px and 127px needed for their widest one-line contents. Reducing the description to 200px does not reduce any row height."
    },
    {
     "design": "r1C",
     "good": "The wide description column gives the descriptive text a more generous measure, and prices and headers remain intact.",
     "problems": "The name columns are cramped: the Lao name in the second dish wraps, and the final Thai name spreads over three lines. This disrupts the paired-name comparison and makes the last two rows taller.",
     "cause": "Widths of 84px and 85px leave only 63px and 64px for names. The extra space given to the 232px description column does not compensate for the resulting name wraps."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  }
 },
