{
 "id": "x-s-same-text@phone",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "四列比例较均衡，首列与三个内容列的对应关系容易看出。前三行高度一致，整体节奏稳定；数字、百分号和英文缩写也保持完整。",
     "problems": "最后一行的“发布周期缩短到一周”占三行，末尾单独留下“周”，使表格底部显得零碎。首列和表头均有换行，但仍可辨认。",
     "cause": "第4列为94px，扣除21px后文本宽度约73px，不足以让末尾“一周”一起留在第二行。"
    },
    {
     "design": "r0B",
     "good": "首列的三个指标名称均保持单行，便于纵向定位，也突出了它们作为行标题的作用。",
     "problems": "首列占据过多空间，三个承担相似角色的内容列显得局促。第二、第三列的标题和内容被切成较短的片段，表头因此增高；最后一行也有较重的换行负担。",
     "cause": "首列宽129px，而第2至第4列只有76、76、78px；扣除内边距和边框后，各列文本宽度仅55至57px。"
    },
    {
     "design": "r0C",
     "good": "第4列较宽，较长的改进描述只占两行，最后一行较紧凑；该列标题也保持单行。",
     "problems": "首列和第三列标题被切得过碎，尤其“客户满意度提升”在首列和表头都占三行，削弱了同一名称在两个方向上的对应关系。第4列明显宽于其他内容列，表格重心偏右。",
     "cause": "第4列占124px，挤压首列至75px、第2和第3列至80px；首列扣除21px后仅有54px文本宽度。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "四行高度一致，行标题与对应内容容易横向对照；三个内容列的宽度也比较接近。年度增长 25%、NPS 和 50 都保持完整，第四列的描述占两行。",
     "problems": "第二列的目标描述在“增长”后换行，使数值与所描述的增长分离；第四列标题在“改”和“进”之间换行，词组不够完整。首列与各内容列的文字密度也略有差异。",
     "cause": "第二列宽 85px，扣除边距和边框后可用 64px；第四列宽 98px，可用 77px，容不下完整标题。"
    },
    {
     "design": "r1B",
     "good": "首列较宽，行标题比较醒目；NPS 和数字保持完整，前三行高度一致。",
     "problems": "第二列标题和目标描述的断行较零碎；第四列描述增至三行，拉高最后一行，使其他单元格出现较多空白，削弱整表节奏。",
     "cause": "首列增至 98px 后，第二列只有 82px、第四列只有 92px；第四列扣除边距和边框后可用 71px，不足以维持描述的两行排布。"
    },
    {
     "design": "r1C",
     "good": "第四列较宽，研发描述保持两行；四行高度一致，整体紧凑。",
     "problems": "第二列的目标描述断行较零碎；第三列把“提升”拆到两行，影响阅读。第四列增加的宽度没有明显改善行高或标题断行。",
     "cause": "第四列占 106px，挤压了第二、第三列；它们分别只有 82px 和 85px，扣除边距和边框后可用 61px 和 64px。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "四列比例平稳，首列行标题与对应列标题都能辨认；三行均为两行高，横向对照节奏一致，25%、NPS 和 50 保持完整。",
     "problems": "第三列标题断成「客户满意／度提升」，第四列标题断成「研发效能改／进」，都切开了语义紧密的词组；第四列最后一行的描述也较拥挤。",
     "cause": "第三列宽 87px、第四列宽 98px，扣除内边距和边框后，分别只能容纳约四个和五个汉字，恰好把标题断在不理想的位置。"
    },
    {
     "design": "r2B",
     "good": "第三列增宽后，NPS 所在单元格周围更宽松；各行高度一致，数字和英文缩写保持完整。",
     "problems": "第二列标题断成「年度经／营目标」，内容断成「营收增／长 25%」，两处都拆开了词语。第三列获得的空间没有改善其标题断句，整体收益不足以抵消第二列的损失。",
     "cause": "第二列缩至 82px，可用文本宽度约 61px；第三列增至 93px 后，可用宽度仍不足以完整容纳「客户满意度」五个汉字。"
    },
    {
     "design": "r2C",
     "good": "首列略宽，有助于稳定行标题；第二列的标题和内容均比 r2B 更易读，数字与英文缩写完整，各行节奏一致。",
     "problems": "第三、四列标题仍分别切开「满意度」和「改进」；首列增加的宽度没有明显改变换行，空间收益有限。",
     "cause": "首列宽 90px，但仍不足以让最长行标题完整显示；第三列宽 86px、第四列宽 98px，也都未达到更理想标题断句所需的宽度。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B",
    "r3C"
   ]
  }
 },
