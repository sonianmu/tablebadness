  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "组件名称和支持状态均保持单行，三个版本列等宽，便于横向比较和纵向扫描。说明均为两行，七个数据行高度一致，整表节奏稳定。",
     "problems": "说明列中的长句仍需换行，但换行后的内容易读，未见明显影响阅读的断裂。",
     "cause": "组件列 133px 恰好容纳最长名称；三个版本列各 83px，恰好容纳最长状态；剩余 337px 分配给说明，在各列需求之间取得了良好平衡。"
    },
    {
     "design": "r0B",
     "good": "版本列等宽，状态保持单行；较宽的说明列让部分句子的断行更从容。",
     "problems": "多数组件名称被拆成两行，部分词组在不自然的位置断开，削弱了按组件快速定位行的能力。尽管说明列加宽，表格高度与 r0A 相同。",
     "cause": "组件列从 133px 缩至 105px，可用文本宽度不足以容纳较长名称；让出的 28px 加给说明列后，并未减少数据行的行数。"
    },
    {
     "design": "r0C",
     "good": "组件名称完整，版本列等宽且状态清晰，三个版本之间的比较关系明确。",
     "problems": "版本列留白偏多，说明列显得局促；两条说明增至三行，行高不再统一，表格也更高。部分版本信息被拆到相邻行，阅读连续性较差。",
     "cause": "三个版本列各增至 103px，合计多占 60px；说明列因此缩至 277px，而状态文本并不需要这些额外宽度。"
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
