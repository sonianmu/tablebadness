    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "四行高度一致，三项角色列的权重较均衡；数据与破折号都容易辨认，数字和缩写没有被拆开。",
     "problems": "首列三个行标题都换成两行，削弱了定位指标时的扫读速度；第二列标题末字单独落在第二行，节奏不佳。",
     "cause": "首列110px不足以容纳最长行标题；第二列111px的文字空间不足以完整容纳“年度经营目标”。"
    },
    {
     "design": "r0B",
     "good": "首列行标题均保持一行，查找路径清晰；各行高度一致，三项有效内容均为两行，表格节奏稳定。",
     "problems": "第二、三列标题和内容都比较拥挤；“NPS 提升到 50”被拆成“NPS 提升／到 50”，词组衔接略显生硬。第四列仍有一定余量。",
     "cause": "首列143px优先保证了行标题完整，留下第二列100px、第三列107px；第四列129px的文字空间对其两行内容略有余量。"
    },
    {
     "design": "r0C",
     "good": "第四列内容保持一行，三个有效条目位置清楚，数字和缩写完整。",
     "problems": "首列标题和行标题过窄，多个词语被拆散；“客户满意度提升”占三行，使该行明显高于其他行，行标题扫读也变慢。第四列显得过宽。",
     "cause": "首列89px只有68px文字空间，而第四列177px为保持最长内容一行占用了过多宽度。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "整体节奏均匀，四列权重协调；第4列表头完整，改进内容也保持两行。各行的有效内容和空项容易区分。",
     "problems": "第2列表头在“年度经营”后断开，首列“客户满意度提升”末字单独落行；第3列的“50”单独落行，数字与NPS之间的联系稍弱。",
     "cause": "首列130px不足以容纳最长行标题；第2列105px和第3列112px分别不足以容纳完整表头及“NPS 提升到 50”。"
    },
    {
     "design": "r1B",
     "good": "首列三个行标题均完整显示，行定位清楚；第3列的“到 50”保持在同一行，比数字单独落行更自然。",
     "problems": "三个角色列表头全部换行，第4列表头末字单独落行；第4列内容也在“缩短”之间断开，影响词语完整性。",
     "cause": "首列143px获得了完整行标题所需的空间，但第4列缩至122px，表头及正文的可用宽度不足。"
    },
    {
     "design": "r1C",
     "good": "三列角色内容所占空间较接近，空项清楚，各行高度一致。",
     "problems": "首列三个行标题全部换行，第1、3个标题出现末字单独落行；三个角色列表头也都换行，其中第2、3、4列均出现末字单独落行。整体产生较多零碎的短行，查找路径不够清晰。",
     "cause": "首列120px不足以保持行标题完整；第2列110px、第3列125px和第4列124px又分别落在表头完整显示所需宽度以下。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "三列角色的宽度较接近，数值和破折号清楚，数据行高度一致，横向查找容易。",
     "problems": "“客户满意度提升”作为行标题时末字单独换到第二行，辨认节奏被打断；第三、四列表头也分别留下较短的尾行。",
     "cause": "首列140px略不足以容纳该行标题；第三列112px和第四列122px不足以完整容纳各自表头。"
    },
    {
     "design": "r2B",
     "good": "第三列比r2A更宽，角色列之间仍有清晰的分隔；数值、单位和破折号保持完整。",
     "problems": "首列行标题仍有单字尾行，第三列表头同样留下单字尾行，视觉上比r2A更零碎；第四列表头也换行。",
     "cause": "首列130px不足以容纳最长行标题；第三列125px允许表头排入更多字，却仍不足以排完整个标题；第四列119px不足以容纳完整表头。"
    },
    {
     "design": "r2C",
     "good": "首列143px使三个行标题均保持单行，定位行更顺畅；三列角色仍有相近的视觉权重，数值和破折号完整。",
     "problems": "三个角色表头均换行，其中第四列表头的末字单独成行；第二列目标内容也分成两行。",
     "cause": "第二列100px、第三列115px和第四列121px都不足以完整容纳各自表头；第二列内容宽度也不足以让“营收增长 25%”同排。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B"
   ]
  }
