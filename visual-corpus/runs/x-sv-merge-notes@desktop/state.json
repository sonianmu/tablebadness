  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "报价保持完整；较宽的评审意见列让共同结论舒展，并清楚地关联甲、乙两行。",
     "problems": "供应商名称、部分列标题以及交期和质保的数值与单位被拆成两行，削弱了逐行阅读和纵向比较。四行都因此显得过高。",
     "cause": "供应商列64px、交期列52px和质保列48px扣除内边距及边框后过窄；评审意见列469px占用了过多宽度。"
    },
    {
     "design": "r0B",
     "good": "标题、供应商名称和指标值均保持完整，三项指标易于纵向比较；共同评审意见分两行，阅读清楚。",
     "problems": "指标列略显宽松，评审意见列相对紧张，长意见和丙的无效投标说明都换成两行。",
     "cause": "报价列110px、交期和质保列各75px占用了较多宽度，使评审意见列为383px；丙的说明受三个指标列合计260px的限制。"
    },
    {
     "design": "r0C",
     "good": "标题、供应商名称和指标值保持完整；指标列紧凑，评审意见列较宽，共同结论分两行且留白较舒展。",
     "problems": "交期和质保列较窄，数值靠近边界；丙的说明在“文件”一词中间换行，影响阅读。",
     "cause": "交期列60px和质保列55px接近内容所需宽度；三个指标列合计209px，使跨列说明在不理想的位置换行。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "供应商、金额和各项指标清楚完整；甲、乙的共同意见分两行，跨两行的关系容易辨认。",
     "problems": "丙的无效投标说明被挤成两行，末尾留下较短的一行，使该行明显高于前两行。",
     "cause": "报价、交期和质保三列合计230px，供横向合并说明使用的宽度不足；评审意见列则有419px。"
    },
    {
     "design": "r1B",
     "good": "三个指标列更宽松，金额与数值易于纵向比较；共同评审意见仍保持两行。",
     "problems": "丙的说明仍换成两行，第二行较短；共同意见首行在“重点”后断开，语意衔接稍弱。",
     "cause": "三个指标列合计255px，较其他方案更宽，但尚不足以容纳完整说明；评审意见列为394px。"
    },
    {
     "design": "r1C",
     "good": "指标列紧凑，评审意见列宽，文字与数字均未出现词中断开。",
     "problems": "丙的说明仍需两行，而评审意见列比r1A更宽却没有减少行数；指标列因此显得较局促。",
     "cause": "三个指标列仅合计220px，评审意见列占429px，宽度分配对共同意见的行数没有带来可见收益。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "供应商名称、金额、交期和质保均保持完整，表头清晰；甲、乙共用的评审意见分两行，容易与两家供应商对应。",
     "problems": "丙的无效投标说明末尾的“投标”被挤到第二行，形成短尾；三个指标列的空白较多。",
     "cause": "报价、交期和质保列合计290px，横跨单元格的可用文字宽度不足以容纳完整说明。"
    },
    {
     "design": "r2B",
     "good": "各列标题和指标值均完整，三个指标列稍宽，纵向比较从容。",
     "problems": "丙的说明只剩“标”字落在第二行，比r2A更零碎；评审意见也因列宽缩小而在“谈判”中间换行。指标列仍有较多空白。",
     "cause": "三个指标列合计310px，仍略不足以让丙的说明完整排成一行；评审意见列从359px缩至339px，改变了长意见的断行位置。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B",
    "r3C"
   ]
  }
