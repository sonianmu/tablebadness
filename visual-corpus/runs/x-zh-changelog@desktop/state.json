   "critique": [
    {
     "design": "r0A",
     "good": "版本号和日期完整，变更内容列宽充裕，技术标识符没有被拆开。",
     "problems": "类型表头和每个类型值都竖向换行，破坏纵向扫描；“新功能”占三行，使整行过高，表格节奏松散。",
     "cause": "类型列宽51px，扣除21px内边距与边框后仅剩30px，容不下两个汉字；过多宽度因此留给了变更内容列。"
    },
    {
     "design": "r0B",
     "good": "四个表头和类型值均保持完整，版本、日期易于纵向查找；变更内容获得较大空间，行高也较紧凑。",
     "problems": "性能更新的第二行只有“现。”，形成很短的尾行，削弱该记录的阅读节奏。",
     "cause": "变更内容列宽480px，正文恰好在“实现”中间换行；类型列宽67px已基本贴合最长类型，其他标识列也较紧凑，调整余地有限。"
    },
    {
     "design": "r0C",
     "good": "表头、类型和标识列都有充足空间，列间层次清楚，技术标识符保持完整。",
     "problems": "版本、日期和类型列的额外空白压缩了正文；首条更新因此把问题编号单独推到第二行，且性能更新也需要两行。",
     "cause": "前三列合计300px，比r0B多61px，导致变更内容列缩至419px。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "版本号、日期和技术标识符保持完整；变更内容有充足空间，长记录控制在两行内，表格充分利用视口。",
     "problems": "“新功能”被拆成两行，破坏类型列的纵向扫描节奏，也使这一行的左侧显得局促。",
     "cause": "类型列宽66px，扣除21px后仅剩45px，比其完整内容所需的46px少1px。"
    },
    {
     "design": "r1B",
     "good": "版本号、日期和技术标识符保持完整，变更内容仍最多两行，右侧留有少量余白。",
     "problems": "“新功能”同样被拆成两行；变更内容列比r1A窄，却没有减少行高或改善阅读，右侧余白也没有明显作用。",
     "cause": "类型列仍为66px，内容空间不足1px；变更内容列缩至465px，使部分文字更早换行。"
    }
   ],
   "done": false,
   "names": [
    "r2A"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "版本号和日期完整，类型可纵向扫描，表头均保持单行。变更内容获得主要空间，技术名称、问题编号和性能数值也未被拆开；边框使每条记录保持清晰。",
     "problems": "第二条的“企业微信”和第三条的“实现”被分到行末与下一行，续行较短，中文语句的阅读节奏略显零碎。",
     "cause": "变更内容列为480px，恰好在这些词附近触发换行。前三列分别为64px、108px和67px，基本对应完整显示版本号、日期和最长类型所需的最小宽度，因此可供内容列使用的空间有限。"
    }
   ],
   "done": false,
   "names": [
    "r3A"
   ]
  }
