   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "All headers, codes, population figures, and individual words remain intact. The Arabic names have enough room, and the notes receive the most space of the three designs, keeping the rows comparatively compact.",
     "problems": "The narrow notes column produces tall rows and leaves substantial empty space under the shorter entries. The Hebrew name תל אביב wraps, although it remains readable as two intact words.",
     "cause": "The notes have 78px of text space at a width of 99px; the Hebrew column has 31px of text space at 52px."
    },
    {
     "design": "r0B",
     "good": "The wider Hebrew column gives its names more room, while the headers, codes, figures, and individual words remain intact.",
     "problems": "The notes become a narrow stack of short lines, making the first and last rows much taller and weakening the sense of each row as a unit. The wider Hebrew column does not prevent תל אביב from wrapping in the render.",
     "cause": "Moving 20px from notes to Hebrew leaves notes only 58px of text space at 79px, while the 72px Hebrew column is still 2px short of its stated one-line content width including padding."
    },
    {
     "design": "r0C",
     "good": "The notes retain nearly as much width as in r0A, and the Hebrew column has more room.",
     "problems": "The Arabic header wraps and الرياض splits within the word, damaging both the header hierarchy and the readability of a city name. The taller header and last row also make the table longer than r0A.",
     "cause": "The 55px Arabic column leaves only 34px of text space, less than the 45px needed for its longest unbreakable word."
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "Codes, Arabic city names, population figures and headers remain intact. The right-to-left sequence is easy to follow, and each row stays visually distinct.",
     "problems": "The notes form a narrow, dense block with substantial empty space in the other cells of the taller rows. The Hebrew name תל אביב wraps, though its words remain intact.",
     "cause": "The 96px notes column leaves 75px for text, forcing extensive wrapping. The 55px Hebrew column leaves 34px, less than the 53px needed for its longest one-line name."
    },
    {
     "design": "r1B",
     "good": "The compact fields and headers remain intact, and the rows preserve the same clear reading order as r1A.",
     "problems": "The notes are still dense and tall, while the extra width given to the Hebrew column produces no visible improvement over r1A: תל אביב still wraps.",
     "cause": "The 58px Hebrew column leaves only 37px for text, still short of the 53px needed to keep the name on one line. Moving those 3px from notes leaves that column at 93px without changing the overall row heights."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "The headers remain on one line, and codes, population figures, and individual words stay intact. The wider notes column keeps the rows substantially shorter than in r2B.",
     "problems": "The notes are still a narrow, dense stack, making rows tall and leaving large areas of white space in the other columns. The Hebrew name for Tel Aviv wraps onto two lines.",
     "cause": "The 99px notes column leaves 78px for text. The 52px Hebrew column leaves 31px, enough for each word but not the full 53px name."
    },
    {
     "design": "r2B",
     "good": "The 74px Hebrew column keeps multiword city names on one line, making that column easier to scan. Codes and population figures remain intact.",
     "problems": "The notes header splits, and the notes form very tall, narrow blocks. The extra height produces large empty areas in the other columns and weakens the sense of each row as a unit.",
     "cause": "Increasing the Hebrew column from 52px to 74px reduces the notes column from 99px to 77px. Its 56px text area is narrower than the 58px header and leaves little room for note text."
    }
   ],
   "done": true,
   "names": [
    "r2A",
    "r2B"
   ]
  }
