   "critique": [
    {
     "design": "r0A",
     "good": "节次与时间清楚地定位每一行；时间范围保持完整，周二至周四的列宽一致，短课程易于扫描。",
     "problems": "周五的长课程占三行，使第三节明显偏高；周一的长课程也换成两行。周五比其他日期列宽，但仍未换得足够紧凑的排版。",
     "cause": "周五宽95px，扣除21px后文字区为74px，容不下足够的汉字以排成两行；周一宽63px，文字区为42px，因此长课程换行。"
    },
    {
     "design": "r0B",
     "good": "五个日期列宽度接近，视觉节奏均匀，时间和短课程保持完整。",
     "problems": "周五长课程被挤成四行，第三节过高，其他日期在该行留下大片空白，削弱了横向比较的节奏。",
     "cause": "周五仅宽69px，文字区为48px；平均分配日期列宽，没有照顾该列明显较长的课程名称。"
    },
    {
     "design": "r0C",
     "good": "周一的长课程分成较自然的两行；周二至周四宽度一致，短课程和表头均完整。",
     "problems": "周五的长课程仍占三行，第三节偏高；周一比三个中间日期列宽出不少，日期列的节奏不够均衡。",
     "cause": "周一宽87px，文字区为66px，较两行排版所需的空间更宽；周五宽98px，文字区为77px，仍不足以让长课程排成两行。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
