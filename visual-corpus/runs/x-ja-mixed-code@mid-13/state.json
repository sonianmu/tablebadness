 "understanding": {
  "purpose": "CLI オプションと短縮形、それぞれの動作を参照する表。",
  "reading": "左からオプション名、対応する短縮形、説明の順に読み、オプション名を縦に走査して目的の行を探す。説明の折り返しによる行高を使い、行全体を一つの単位として読む。",
  "groups": [
   "オプションと短縮形は対応する識別子なので、隣接したコンパクトな列として扱う。",
   "説明は各識別子の意味を示す文章列で、残りの幅を優先的に使う。"
  ],
  "keep_intact": [
   "--output-dir、--watch、--config などのオプション名",
   "-o、-w、-c などの短縮形",
   "tb.config.json などのファイル名"
  ],
  "may_wrap": [
   "説明文は自然な箇所で折り返せる。",
   "幅を説明に回す案では、短縮形の列見出しを折り返せる。"
  ]
 },
