  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "योजना के नाम और विवरण शब्द सीमाओं पर टूटते हैं। वर्ष और चारों शीर्षक साफ़ और एक पंक्ति में हैं।",
     "problems": "लाभार्थी की संख्या और करोड़+ अलग पंक्तियों में हैं, जिससे तुलना धीमी होती है। पहले और तीसरे विवरण के लंबे ऊर्ध्वाधर अनुच्छेदों के साथ योजना वाले खाने में खाली जगह बनती है।",
     "cause": "लाभार्थी की 65px चौड़ाई पूरी संख्या और चिह्न के लिए अपर्याप्त है। योजना को 108px देने के बाद विवरण के लिए 120px बचते हैं।"
    },
    {
     "design": "r0B",
     "good": "तीनों में सबसे संतुलित विवरण स्तंभ है: पाठ अपेक्षाकृत सहज पंक्तियों में पढ़ता है और पंक्तियाँ एक साथ बँधी लगती हैं। शीर्षक और वर्ष एक पंक्ति में हैं।",
     "problems": "पहली योजना का नाम तीन पंक्तियों में बँटता है और सभी लाभार्थी संख्याएँ अपने करोड़+ चिह्न से अलग हो जाती हैं।",
     "cause": "योजना के 90px में पाठ के लिए 69px बचते हैं; लाभार्थी के 65px में केवल 44px। विवरण को मिले 138px से इसकी पठनीयता बेहतर होती है।"
    },
    {
     "design": "r0C",
     "good": "योजना के नाम आसानी से पहचाने जाते हैं और छोटे नाम एक पंक्ति में रहते हैं। शीर्षक और वर्ष भी एक पंक्ति में हैं।",
     "problems": "विवरण बहुत संकरी पट्टी में टूटता है, जिससे पहली और तीसरी पंक्तियाँ अत्यधिक लंबी और दूसरे स्तंभ खाली दिखाई देते हैं। लाभार्थी संख्या भी चिह्न से अलग है।",
     "cause": "योजना के लिए 132px रखने से विवरण को केवल 96px मिलते हैं; लाभार्थी की 65px चौड़ाई पूरी संख्या के लिए पर्याप्त नहीं है।"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "शीर्षक, वर्ष और लाभार्थियों की संख्याएँ एक पंक्ति में हैं। योजना के नाम शब्दों के बीच टूटते हैं और हर पंक्ति को पहचानना आसान है।",
     "problems": "विवरण में छोटी पंक्तियाँ बनती हैं; विशेषकर पहली योजना का विवरण छह पंक्तियों में फैलता है। योजना के नाम के नीचे काफी खाली जगह है।",
     "cause": "विवरण को 127px और योजना को 83px मिले हैं। विवरण की लंबाई के मुकाबले योजना के लिए कुछ अधिक जगह रखी गई है।"
    },
    {
     "design": "r1B",
     "good": "विवरण को थोड़ी अधिक जगह मिलने से वाक्यांश बेहतर ढंग से साथ रहते हैं। शीर्षक और तुलनात्मक आँकड़े एक पंक्ति में रहते हैं और योजना के शब्द नहीं टूटते।",
     "problems": "पहला विवरण अभी भी छह पंक्तियों में है और उसके सामने खाली जगह बनी रहती है। तीसरे विवरण की अंतिम पंक्ति छोटी है।",
     "cause": "योजना की चौड़ाई 78px करने पर भी विवरण को केवल 132px मिलते हैं; लंबे विवरण के लिए यह अब भी सीमित है।"
    },
    {
     "design": "r1C",
     "good": "योजना के नामों के आसपास अधिक जगह है और सभी शीर्षक व संख्याएँ एक पंक्ति में हैं।",
     "problems": "तीसरा विवरण अधिक पंक्तियों में टूटता है और उसकी पंक्ति लंबी हो जाती है, जबकि योजना स्तंभ में अतिरिक्त जगह से नामों की पंक्तियों की संख्या कम नहीं होती।",
     "cause": "योजना को 90px देने से विवरण 120px तक सिमट गया है; अतिरिक्त चौड़ाई उस स्तंभ से ली गई है जिसे इसकी अधिक जरूरत है।"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "चारों शीर्षक एक पंक्ति में हैं और वर्ष तथा लाभार्थियों के आँकड़े आसानी से तुलना योग्य हैं। विवरण को तीनों विकल्पों में सबसे अधिक जगह मिलती है; पंक्तियाँ स्पष्ट इकाइयों की तरह पढ़ी जाती हैं।",
     "problems": "पहली योजना का नाम तीन पंक्तियों में और उसका विवरण छह पंक्तियों में है, जिससे पहली पंक्ति बहुत ऊँची दिखती है।",
     "cause": "योजना के लिए 73px और विवरण के लिए 137px हैं। सीमित कुल चौड़ाई में लंबे नाम और विशेषकर लंबे विवरण को लपेटना आवश्यक है।"
    },
    {
     "design": "r2B",
     "good": "योजना के लिए अतिरिक्त जगह है; शीर्षक और संक्षिप्त तुलनात्मक आँकड़े एक पंक्ति में बने रहते हैं।",
     "problems": "योजना का नाम r2A जितनी ही पंक्तियाँ लेता है, जबकि विवरण की पंक्तियाँ अधिक छोटी और बिखरी हुई दिखती हैं। समग्र ऊँचाई भी नहीं घटती।",
     "cause": "योजना को 80px देने पर उसके दृश्य लपेट में सुधार नहीं होता, लेकिन विवरण 130px तक सिमट जाता है।"
    },
    {
     "design": "r2C",
     "good": "शीर्षक और संख्याएँ एक पंक्ति में हैं; पंक्तियों और स्तंभों की संरचना स्पष्ट रहती है।",
     "problems": "लाभार्थी स्तंभ में अतिरिक्त जगह का कोई स्पष्ट दृश्य लाभ नहीं है, जबकि विवरण के लिए थोड़ी कम जगह बचती है। समग्र ऊँचाई r2A जैसी ही है।",
     "cause": "लाभार्थी को 85px देने से विवरण 135px रह जाता है; लाभार्थी की एक-पंक्ति सामग्री पहले ही 83px में समा जाती है।"
    }
