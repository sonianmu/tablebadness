  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "Every metadata column sits exactly at its natural single-line width: ID 96 holds BUG-2041 (75), Severity 80 holds Critical/High/Low (59), Assignee 87 holds m.garcia/a.okafor (66), Status 98 holds “In progress” (77), Updated 108 holds 2024-06-02 (87). Nothing is split mid-token, dates and statuses stack into clean vertical runs, and the title never needs more than two lines. It is the only layout that achieves all of this.",
     "problems": "Title gets only 250px (35% of the table) and 4 of 6 titles break into a short, weak second line (“on Safari 17”, “containing emoji”, “notification worker”); row heights alternate 36/60, so the left edge of the table pulses rather than flows. The date column sits flush against the right border with only its 21px padding.",
     "cause": "The five metadata columns consume 469px (65%) at their exact minimum one-line widths (96+80+87+98+108), leaving Title the arithmetic remainder 719−469 = 250. There is zero slack anywhere to move: 1px off Status breaks “In progress”, 1px off Updated splits a date, 1px off Assignee splits a handle, 1px off Severity wraps the header."
    },
    {
     "design": "r0B",
     "good": "Title at 291 is genuinely comfortable — long titles break at more natural clause boundaries and the column reads as the dominant one.",
     "problems": "“In progress” splits into “In” / “progress”, and every date splits at the hyphen into “2024-” / “06-02”. Because the two most-scanned triage columns are now ragged, vertical comparison of status and recency collapses; every row becomes 60px and the table grows to 394px with no gain in information.",
     "cause": "Status was cut to 82 (61px of text vs the 77px “In progress” needs) and Updated to 83 (62px vs the 87px a date needs) to fund the +41px title gain. The width was taken from the two columns whose whole value is being scannable in a straight line."
    },
    {
     "design": "r0C",
     "good": "The right rail is calm: Severity, Assignee, Status and Updated all single-line with visible air, and dates/statuses align perfectly for scanning.",
     "problems": "The title is starved: long titles take three lines, row 3 jumps to 83px, and “long-running” is broken at its own hyphen, splitting a compound word. Meanwhile Status (112) and Updated (138) carry roughly 30–50px of dead space each, so the eye is drawn to empty metadata while the meaningful column is squeezed.",
     "cause": "Over-allocation to Status (+14) and Updated (+30) beyond what their content needs, taken straight out of Title (206 = 185px of text, below the ~227px a 52-character title needs to stay at two lines)."
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
