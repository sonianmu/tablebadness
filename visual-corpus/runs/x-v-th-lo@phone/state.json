  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "The paired name columns have equal weight, prices stay on one line, and all headers are intact. The description has enough room to form readable phrases.",
     "problems": "The final dish names wrap heavily, especially the Thai name, while the first and last descriptions make their rows tall. The two name columns feel cramped beside the price column.",
     "cause": "At 80px each, the name columns have 59px of text space. The 121px description column has 100px, which still requires several lines for the longer descriptions; the 78px price column is as wide as either name column."
    },
    {
     "design": "r0B",
     "good": "The wider paired name columns make the dish names easier to scan, and prices remain intact and aligned.",
     "problems": "The description becomes a narrow vertical stack of short fragments, its header wraps, and the resulting tall rows leave extensive empty space in the other columns. This makes it harder to read across each row.",
     "cause": "The 100px name columns consume space needed by the description, which is only 81px wide with 60px of text space."
    },
    {
     "design": "r0C",
     "good": "The wider description produces more coherent phrases and a shorter, more balanced table than r0B. Prices and headers remain intact.",
     "problems": "Both name columns are cramped: even the first dish names wrap, and the last Lao name becomes a tall stack. That weakens the pairing of the two names and makes dish identification slower.",
     "cause": "The 70px name columns provide only 49px of text space, while the 141px description column takes a larger share of the available width."
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "The Thai and Lao names have equal visual weight, prices stay on one line, and each row reads across clearly. The description uses the height created by wrapped dish names.",
     "problems": "The first and last descriptions make their rows tall, while the last Thai dish name breaks into three lines.",
     "cause": "The 125px description column leaves 104px for text; the 78px Thai name column leaves 57px."
    },
    {
     "design": "r1B",
     "good": "The paired name columns remain balanced, and prices stay intact and easy to compare.",
     "problems": "The wider name columns do not noticeably improve the longest Thai name, while the first description becomes five lines and creates a particularly tall row.",
     "cause": "Increasing each name column to 85px reduces the description column to 111px, leaving only 90px for its text."
    },
    {
     "design": "r1C",
     "good": "The wider description column improves the first row, and the paired name columns remain balanced.",
     "problems": "Every price wraps its currency unit onto a second line, weakening price comparison and making the narrow price column feel crowded. The last description still takes four lines.",
     "cause": "The 69px price column leaves only 48px for text, less than the 57px needed for the longest price. The 130px description column still leaves only 109px for text."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  }
 },
