 "modelsUsed": [
  "opencode-zen-free/deepseek-v4.1-flash-free"
 ],
 "understanding": {
  "purpose": "Define travel-reimbursement limits by expense item and employee grade, so readers can look up their entitlement and compare grades.",
  "reading": "Row-first: identify the expense item in column 1, then scan right across the three grade columns. Column scanning is secondary, for comparing one grade's package. Rows must read as units, and the grade columns must stay directly comparable.",
  "groups": [
   "Columns 2–4 are one peer group: 普通员工, 经理 and 总监 are parallel entitlement levels, so they need comparable widths and alignment.",
   "Column 1 is the row-header key; it should remain visually distinct and readable but not dominate the table."
  ],
  "keep_intact": [
   "Amount+unit pairs such as 500 元/晚, 350 元/晚, 80 元/日限额 and 120 元/日限额",
   "Fare/class terms 二等座, 一等座 and 经济舱",
   "The number–unit pair 7 天 in 提前 7 天预订",
   "Row labels 一线城市住宿, 其他城市住宿, 高铁, 飞机 and 市内交通"
  ],
  "may_wrap": [
   "Qualifiers 含早餐, 省会城市可上浮, 需提前 7 天预订 and 可改签一次",
   "The comma-separated second clause in each cell",
   "Longer row labels only in label-compressed designs"
  ]
 }
}