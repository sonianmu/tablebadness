 "id": "n-code-regex@desktop",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "Field at 147px keeps every snake_case identifier on one line; Example at 188px exactly meets the 167px unbreakable-word floor; Pattern at 206px is the widest of the three, so the email regex is 8 lines rather than 9 or 11; all headers stay on one line.",
     "problems": "The Error column at 178px is at its absolute minimum and looks cramped: phone, slug and VAT messages break into many short lines with orphaned words. The table reaches 965px, and the 199px account row plus 153px phone row make the layout feel vertically unstable. Example values still wrap to two lines, so rows do not read as evenly as they could.",
     "cause": "Widths [147,206,188,178] put Example and Error exactly at their minimums while giving Pattern 71px above its floor. But Pattern still needs 8 lines for the email regex even at 206px, so the extra Pattern width buys no further line reduction, whereas the missing Error width costs several lines."
    },
    {
     "design": "r0B",
     "good": "Error at 202px is comfortable and keeps most prose to 3–4 lines; phone, postal, effective-date and VAT rows are compact. Field and Example remain intact, and the overall table is the shortest at 849px. This is the most promising starting point.",
     "problems": "Pattern at 160px is too narrow: the email regex becomes a 9-line strip, the postal regex orphans its final '$', and several regexes fragment at awkward points. The account row grows to 222px. Example at 210px is over-wide for its actual benefit: the long email and slug examples still wrap to two lines.",
     "cause": "Widths [147,160,210,202] distribute the 50px above minimums almost evenly (Pattern +25, Example +22, Error +24), but Pattern has by far the largest content demand. Example's extra 22px cannot reach the roughly 285px needed to put the email example on one line, so that width is slack while Pattern sets the tallest row."
    },
    {
     "design": "r0C",
     "good": "Error at 249px is very readable, with prose held to 3–4 lines; Example at 188px preserves its longest unbreakable word; Field is intact and headers are clean.",
     "problems": "Pattern at 135px is at its minimum and collapses: the email regex runs to 11 lines and the account row becomes 269px. The phone regex splits '1-9' across lines, the postal regex leaves '$' alone, and the fragments are hard to parse. The wide Error column creates visible dead space beside the tall Pattern cell.",
     "cause": "Widths [147,135,188,249] send all 71px of discretionary width to Error while Pattern sits at its 135px floor. Error prose gains little beyond about 200px, but Pattern loses enough width to add three lines to the email regex, so Pattern alone drives the row height."
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "Strongest current layout: Field at 147px exactly preserves account_email; headers stay on one line; Example valid at 188px holds the longest token and wraps only at safe hyphens; Error at 202px keeps phone and slug messages to four lines; no mid-word splits. Row heights are mostly compact and error copy is comfortable.",
     "problems": "Pattern is the cramped column: the account_email regex breaks into nine short fragments, making the first data row 222px tall while the Error cell beside it has spare vertical space. Error is also wider than Pattern, so prose gets more room than the regex readers must parse.",
     "cause": "Pattern 182px gives only 161px of text, below the wrap threshold for the long email regex; Error 202px gives 181px, safely above the four-line thresholds for phone and slug, so its extra width does not reduce row height."
    },
    {
     "design": "r1B",
     "good": "Pattern at 190px gives 169px and cuts the email regex to eight lines, reducing the first data row from 222px to 199px; Field and Example remain intact and headers stay on one line.",
     "problems": "The gain is cancelled: phone and slug error messages each gain a fifth line, and the table grows to 872px. Error copy looks cramped while Pattern still needs eight lines, so the extra 8px there buys only one saved line.",
     "cause": "Moving 8px from Error to Pattern drops Error from 202px to 194px (181px to 173px text), crossing the four-line wrap thresholds for phone and slug; each extra line adds about 23px, while Pattern saves only one 23px line."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  }
 },
