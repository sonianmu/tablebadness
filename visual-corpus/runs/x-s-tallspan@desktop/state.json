   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "The compact Step and Owner columns keep each pair easy to scan, while the broad Notes column holds the shared text in four lines. All labels and words stay intact.",
     "problems": "The first two columns feel tight against their content, particularly the Step header and Build label; the long note lines also dominate the table.",
     "cause": "Step and Owner are at their minimum content widths of 56px and 69px, leaving 594px for Notes."
    },
    {
     "design": "r0B",
     "good": "The step and owner pairs have comfortable breathing room, and the shared note remains four lines tall. The table has a clear hierarchy and fits the viewport.",
     "problems": "The two short-label columns occupy more space than their contents need, while the note still forms relatively long lines.",
     "cause": "Widths of 90px and 110px allocate 200px to the compact labels, leaving 519px for Notes."
    },
    {
     "design": "r0C",
     "good": "The wider label columns make the step and owner pairs distinct, and the shorter note lines are easy to follow.",
     "problems": "Large empty areas in the first two columns weaken the connection between each step and its owner. The six-line note also stretches the three rows, producing a loose vertical rhythm.",
     "cause": "Giving both label columns 175px leaves only 369px for Notes, increasing wrapping and forcing the merged cell and its rows taller."
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "The compact Step and Owner columns keep each pair easy to scan, while the shared note has a clear, continuous reading area. All labels and words remain intact.",
     "problems": "The note extends into a fourth line, leaving the three rows taller than their short labels need. Its last line is noticeably short.",
     "cause": "The 562px Notes column gives the text enough width for four lines but not enough to fit it into three within the available table width."
    },
    {
     "design": "r1B",
     "good": "The wider Step and Owner columns give the row labels more breathing room, and the note remains intact and readable.",
     "problems": "The first two columns have substantially more space than their content needs. The narrower note still takes four lines, with more frequent line breaks.",
     "cause": "The 90px and 125px widths reserve 58px more for Step and Owner than r1A, reducing Notes to 504px."
    },
    {
     "design": "r1C",
     "good": "The compact label columns preserve a clear row-by-row pairing, and the narrower overall table leaves useful space at the viewport edge. The note still fits in four lines.",
     "problems": "The note is more densely wrapped, and the unused space to the right could support a more relaxed line length.",
     "cause": "The 480px Notes column leaves 82px of available table width unused compared with r1A."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "The step and owner labels are easy to scan as row pairs. The shared note fits in four lines without splitting words, and the table sits comfortably inside the viewport.",
     "problems": "The Owner column has a little more space than its short labels need. The note’s last line is shorter than the lines above it, though the ragged edge remains reasonably balanced.",
     "cause": "The 85px Owner width leaves 64px for text, more than the 48px needed for its header. The 520px Notes width determines the four-line wrap."
    },
    {
     "design": "r2B",
     "good": "All labels remain intact, and the wider note is easy to read across the three-row group. The table uses the available viewport width.",
     "problems": "The note ends with a particularly short fourth line, leaving a conspicuous blank area in the merged cell. The compact first two columns also feel less generous than in r2A.",
     "cause": "The 582px Notes width changes the line breaks without reducing the note below four lines. The 62px Step width leaves only 41px for text."
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B"
   ]
  }
 },
