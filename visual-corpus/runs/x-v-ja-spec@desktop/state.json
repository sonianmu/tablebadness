  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "項目名と寸法が一行に収まり、同幅の製品列を横に比較しやすい。備考の長文も二行に収まり、行ごとの対応が明快。",
     "problems": "連続再生時間の備考は末尾の短い「ります。」だけが二行目に残り、文章の折り返しがやや不均衡。",
     "cause": "備考列312pxでは、その文章を一行に収めるには足りず、折り返し位置が文末近くになる。"
    },
    {
     "design": "r0B",
     "good": "備考を広く取ったため、連続再生時間の補足が一行で読める。製品列も同幅で対応している。",
     "problems": "両製品の寸法で単位mmが次行に離れ、連続再生時間の項目名も分断される。防水性能の備考は末尾の「す。」だけが残る。寸法行も高くなり、表全体のリズムが崩れる。",
     "cause": "製品列125pxでは寸法全体に必要な幅が足りず、項目列100pxも最長の項目名には狭い。備考列369pxは防水性能の文章を一行に収めるにはわずかに不足する。"
    },
    {
     "design": "r0C",
     "good": "項目名と寸法が一行に収まり、同幅の製品列によって比較関係が明快。長い備考も二行で読める。",
     "problems": "製品列には余白が多い一方、備考の防水性能の文章は「浸水」の途中で折り返される。仕様比較に必要な幅を超えて中央に空間が寄っている。",
     "cause": "製品列を各163pxに広げた分、備考列が280pxに狭まり、文章の折り返し位置が窮屈になっている。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "項目名、製品名、寸法、数値と単位、IPX識別子がまとまり、同幅の製品列で左右を比較しやすい。長い備考は2行に収まり、各行の対応も明瞭。",
     "problems": "備考の後半2行は折り返されるが、文章の長さに見合った自然な処理で、目立つ欠点ではない。",
     "cause": "項目列113pxと製品列各147pxは、それぞれ最長の項目名と寸法を1行に収める幅を確保し、残る311pxを備考に配分している。"
    },
    {
     "design": "r1B",
     "good": "項目名と製品値が1行に収まり、同幅の製品列による比較も明快。",
     "problems": "r1Aより製品列に余白が増える一方、備考の折り返し位置が早まり、文章の行末がやや窮屈に見える。行数や表の高さは改善していない。",
     "cause": "製品列を各150pxに広げた分、備考列が306pxに狭まっている。"
    },
    {
     "design": "r1C",
     "good": "同幅の製品列で値を比較しやすく、備考には3案の中で最も広い幅を取れている。",
     "problems": "「連続再生時間」の末尾の「間」だけが次行に落ち、項目名が読みにくい。備考を広げても行数は減っていない。",
     "cause": "項目列108pxでは、パディングと罫線を除いた87pxしか使えず、項目名の1行幅92pxに足りない。"
    }
   ],
   "done": true,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
 },
