{
 "id": "x-sv-spec@phone",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "モデル名と数値を読みやすく保ち、セクション見出しも全幅で明瞭に区切れている。左端の項目名は折り返しても概ね識別しやすい。",
     "problems": "プロの長い説明が細切れになり、行の高さと空白が増えている。連続再生時間の項目名も2行になる。",
     "cause": "プロ列140pxでは説明文に使える幅が119pxしかない。一方、項目列108pxでも連続再生時間を1行にはできない。"
    },
    {
     "design": "r0B",
     "good": "プロ列に幅を与えたことで長文の折り返しが減り、比較する値と注記を追いやすい。両モデルの値も横に比較しやすい。",
     "problems": "項目列が狭く、リフレッシュレートが3行、急速充電が2行になっている。行を探す際の左端の読みやすさが損なわれる。",
     "cause": "項目列80pxでは本文幅が59pxしかない。プロ列168pxへの配分が、左端の項目名を圧迫している。"
    },
    {
     "design": "r0C",
     "good": "連続再生時間と急速充電が1行に収まり、左端から項目を見つけやすい。スタンダード列の値も整っている。",
     "problems": "プロの説明と充電の注記が非常に細かく折り返され、縦長の行と大きな空白を生んでいる。両モデルの値を同じ行で読み合わせにくい。",
     "cause": "項目列137pxに幅を割いた結果、プロ列が111pxとなり、本文幅が90pxに制限されている。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "モデル名と数値が収まり、全幅のセクション行によって比較する仕様の種類が明確。プロ列に十分な幅を寄せているため、長い説明の折り返しも比較的少ない。",
     "problems": "左端の「リフレッシュレート」が3行に分かれ、行の内容をつかみにくい。「連続再生時間」も途中で折り返される。",
     "cause": "1列目の90pxでは文字領域が69pxしかなく、長い項目名を保つには狭い。"
    },
    {
     "design": "r1B",
     "good": "1列目を広げたことで「リフレッシュレート」が2行になり、項目名の形がr1Aより読み取りやすい。両モデルの値を同じ行で比較でき、セクションの区切りも明瞭。",
     "problems": "「連続再生時間」はまだ途中で折り返される。プロの説明は語句の途中で細かく折り返され、急速充電の括弧書きも読みにくい。表の高さはr1Aから改善していない。",
     "cause": "1列目の100pxでは長い項目名に足りず、一方で3列目を148pxに狭めたため、長い説明の文字領域も減っている。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "項目名と両モデルの値を追いやすく、プロの長い説明も5行に収まっている。セクション見出しは全幅に渡り、区切りが明確。",
     "problems": "「スタンダード」が2行に分かれ、連続再生時間の「最大 20 時間」も途中で折り返す。見出しと数値のまとまりが弱い。",
     "cause": "2列目の幅100pxでは、1行幅90pxの見出しに必要な余白を含められず、値にも十分な幅がない。"
    },
    {
     "design": "r2B",
     "good": "プロ列が広く、長い説明と急速充電の注記を比較的読みやすく配置できている。行高はr2Aと同じで、表全体も収まっている。",
     "problems": "「スタンダード」と「最大 20 時間」に加え、「連続再生時間」まで折り返すため、バッテリーの比較行が分断されて見える。",
     "cause": "1列目を105pxに狭めたことで項目名が収まらず、2列目の100pxも見出しと値には不足している。増やしたプロ列の幅は、このレンダーでは行高の短縮に結びついていない。"
    },
    {
     "design": "r2C",
     "good": "1列目が比較的広く、「連続再生時間」が1行に収まるため、左端から項目を探しやすい。",
     "problems": "プロの説明と注記が細切れになり、該当行が高く、白い余白も大きい。「スタンダード」と「最大 20 時間」も折り返したまま。",
     "cause": "1列目と2列目に幅を回した結果、プロ列が134pxとなり、長文が6行に増えている。2列目の105pxも見出しを1行にするには足りない。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B",
    "r3C"
   ]
  }
 },
