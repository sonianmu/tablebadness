  "purpose": "展示需求、开发和测试工作在三个阶段中的安排，包括跨阶段的连续任务。",
  "reading": "先按行查看各项工作，再横向比较阶段；跨列单元格表示任务覆盖相邻阶段，行高可容纳自然换行。",
  "groups": [
   "第2至第4列都是阶段列，需要保持可比较的视觉分量；第3列同时参与两处交错的跨列任务。",
   "第1列是项目类别，帮助读者定位各行，所需宽度小于阶段列。"
  ],
  "keep_intact": [
   "项目类别“需求”“开发”“测试”",
   "阶段一、阶段二、阶段三等列标题",
   "单元格中的短标签和自然词组尽量保持完整"
  ],
  "may_wrap": [
   "需求说明和开发联调等长任务描述可按中文语义自然换行。",
   "同一行较长任务造成的行高可供其他单元格的内容换行使用。"
