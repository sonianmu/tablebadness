  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "项目列紧凑，三个阶段列宽度接近，阶段之间的视觉分量均衡；各标题和短标签均保持完整。",
     "problems": "需求行的长描述占三行，而开发行的跨阶段描述只占两行，造成行高和留白不均。需求描述的末尾单独占一行，阅读节奏较碎。",
     "cause": "阶段一和阶段二各为102px，合并后的可用宽度不足以让需求描述排成两行。"
    },
    {
     "design": "r0B",
     "good": "两处跨阶段任务都排成两行，需求行和开发行高度一致，整体紧凑且容易逐行扫描。",
     "problems": "阶段二明显宽于另外两个阶段，削弱了阶段之间的视觉可比性；“搭建脚手架”被拆成两行，显得局促。",
     "cause": "阶段二为149px，阶段一和阶段三仅为79px；阶段一扣除内边距和边框后，容不下该短标签的一行宽度。"
    },
    {
     "design": "r0C",
     "good": "需求描述排成两行，阶段一的短标签有充足空间，标题也都保持完整。",
     "problems": "开发描述排成三行，开发行明显高于需求行；三个阶段由宽到窄，横向比较时视觉分量不均。",
     "cause": "阶段一占128px，使阶段二和阶段三分别只剩99px和80px；后两列的合并宽度不足以让开发描述排成两行。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "项目列紧凑，三个阶段列分量接近；标题和短标签完整，开发行的跨列任务排成两行，整行易于横向阅读。",
     "problems": "需求说明排成三行，末行仅有“评审”，视觉上偏零碎；第一、二阶段的合并区域略显紧张。",
     "cause": "项目列为52px，阶段一、二合计208px；阶段二、三也合计208px。需求说明较长，因此在当前合并宽度下留下短末行。"
    },
    {
     "design": "r1B",
     "good": "两个跨列任务仍分别保持三行和两行；加宽的阶段二兼顾了两处交错合并，开发行保持紧凑。",
     "problems": "需求说明仍以“评审”单独收尾；阶段二比阶段三明显宽，三个阶段的节奏略不均衡。",
     "cause": "阶段二增至116px、阶段三减至93px；阶段一、二合计214px仍不足以改善需求说明的末行，而阶段二、三合计209px足以维持开发任务两行。"
    },
    {
     "design": "r1C",
     "good": "项目类别、阶段标题和短标签都完整；阶段一较宽，单列内容有充足空间。",
     "problems": "开发任务多占一行，末行只有“平台”，使开发行明显变高；需求说明仍有短末行。",
     "cause": "阶段一增至105px后，阶段二、三合计缩至202px，低于开发任务保持两行所需的宽度；阶段一、二合计214px也未改变需求说明的三行结构。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "项目类别和各阶段标题均保持完整；两个跨阶段任务各自清晰成组，阶段列的分量也较均衡。",
     "problems": "“搭建脚手架”被拆成两行，第二行只有一个字，削弱了开发行的阅读节奏。",
     "cause": "阶段一宽94px，扣除21px的内边距和边框后，文本空间不足以容纳77px的短标签。"
    },
    {
