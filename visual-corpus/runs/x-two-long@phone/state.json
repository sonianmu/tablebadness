  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "维度名称和两个方案标题均保持单行；方案列宽度几乎相等，便于逐行横向比较。三行数据的边界清楚，文字分布也较均衡。",
     "problems": "成本行较高，右侧部分短句末尾留下少量空白；合规行两侧的换行位置也不完全协调。",
     "cause": "维度列为52px，刚好容纳两个汉字；两方案列各约153px，长文需换成多行。"
    },
    {
     "design": "r0B",
     "good": "两方案列仍然等宽，正文可读，且没有词语被强行拆开。",
     "problems": "维度标题及三个维度名称均竖向折成两行，削弱了左侧索引的扫读作用；表头也因此增高。正文行高与r0A相同，增加的方案列宽度没有带来明显收益。",
     "cause": "维度列缩至38px，扣除21px边距和边框后仅剩17px，容不下两个汉字；释放的宽度分配给方案列后，未改变正文行数。"
    },
    {
     "design": "r0C",
     "good": "较宽的方案A列使运维和合规说明更紧凑，左侧维度名称也保持单行。",
     "problems": "方案B标题折行，成本说明增至六行并出现很短的末行；两方案列比例失衡，削弱并列比较的视觉关系。成本行增高，抵消了其他行变紧凑的收益。",
     "cause": "方案A列增至175px，方案B列相应缩至132px；后者扣除边距和边框后，标题及长文的可用宽度不足。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "维度列保持单行，两个方案的标题完整，行内比较关系清楚；正文没有词中断裂。方案 A 略宽，适合其稍长的内容。",
     "problems": "成本和运维两行中，方案 B 的文字比方案 A 少一行左右，右侧留白较明显；合规行两侧都较紧凑。",
     "cause": "维度列占 52px，剩余宽度中 A 为 158px、B 为 149px。两侧宽度接近，但不同文本的换行位置仍使每行的行数不完全一致。"
    },
    {
     "design": "r1B",
     "good": "维度和标题保持完整，同一行的两方案仍容易横向比较；方案 B 较宽，使其成本和运维说明更舒展。",
     "problems": "方案 A 的运维说明被挤得较零碎，而右侧运维单元格仍有较多留白；合规行右侧末尾也出现较短的一行。",
     "cause": "方案 A 缩至 148px，方案 B 增至 159px；多出的宽度没有消除两侧内容长度差造成的留白，却增加了 A 列的换行压力。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "维度列保持单行，两种方案宽度几乎相等，横向比较关系清楚；标题完整，正文没有词中拆分。",
     "problems": "成本行两侧都较密，运维与合规行的右侧留白较多，行内文字块不够均衡。",
     "cause": "维度列为52px，方案列分别为154px和153px；两方案内容长度不同，等宽不能消除每行的文字量差异。"
    },
    {
     "design": "r2B",
     "good": "方案A加宽后，成本和合规说明的每行容纳更多文字；标题及维度名称仍完整。",
     "problems": "方案B明显窄于方案A，作为并列比较对象的视觉分量不够均衡；成本行的20%单独占一行，形成零碎的收尾。",
     "cause": "方案A为161px、方案B为146px，宽度相差15px；方案A当前宽度下的换行位置恰好把20%推到末行。"
    },
    {
     "design": "r2C",
     "good": "方案B加宽后，成本和运维说明较舒展；维度与标题保持完整，行与行的对应关系清楚。",
     "problems": "方案A的成本和运维说明较密，合规说明的末行也较短；两列宽度差异使并列关系略显失衡。",
     "cause": "方案A为145px、方案B为162px，宽度相差17px；较窄的方案A列限制了每行可容纳的文字。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B"
   ]
  }
