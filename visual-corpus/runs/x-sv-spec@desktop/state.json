{
 "id": "x-sv-spec@desktop",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "項目名と列見出しが収まり、各仕様を左から右へ比較しやすい。プロの長い説明だけが自然に2行になり、急速充電の条件は1行で読める。セクション行も明瞭。",
     "problems": "スタンダード列は内容に対して余裕が小さく、プロ列は短い値の行で空白が広い。ただし長い説明と充電条件にはその幅が役立っている。",
     "cause": "スタンダード列120pxに対し、説明文を含むプロ列に443pxを配分しているため。"
    },
    {
     "design": "r0B",
     "good": "項目名と見出しが収まり、スタンダード列にゆとりがある。プロのリフレッシュレートの説明も2行で読める。",
     "problems": "スタンダード列の空白が目立つ一方、プロの急速充電の条件が末尾の「要）」だけ次行に残り、行が間延びする。",
     "cause": "スタンダード列を200pxに広げた分、プロ列が363pxになり、充電条件の全文を収める幅が足りない。"
    },
    {
     "design": "r0C",
     "good": "プロ列が広く、長い説明と充電条件に余裕がある。",
     "problems": "スタンダードの見出し、リフレッシュレートの項目名、最大20時間、30分で50%が折り返され、比較の起点と値が読みにくい。短い仕様行にも高さのばらつきが生じる。",
     "cause": "プロ列に498pxを割いた結果、項目列116pxとスタンダード列105pxのテキスト領域が不足している。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "プロの説明文は2行に収まり、数値と単位も保たれている。セクション行が比較の区切りとして明瞭。",
     "problems": "「リフレッシュレート」の末尾の「ト」だけが次行に落ち、行見出しが読みにくい。",
     "cause": "項目列150pxでは、見出しの一行幅135pxに左右の余白と罫線21pxを加えた156pxに足りない。"
    },
    {
     "design": "r1B",
     "good": "項目名がすべて一行に収まり、左右へ仕様を比較しやすい。スタンダード列にも十分な余白がある。",
     "problems": "スタンダード列の余白が比較的多く、プロの説明は「表示」の途中で折り返されている。",
     "cause": "スタンダード列145pxに幅を割いた分、プロ列が418pxとなり、説明文の折り返し位置が早くなる。"
    },
    {
     "design": "r1C",
     "good": "項目名とスタンダード列の内容が一行に収まり、プロの説明にも広い幅を確保している。比較値とセクションの階層が見やすい。",
     "problems": "プロの説明は「表示時」と「の」の間で折り返され、文のつながりがやや弱い。スタンダードの見出しは収まっているが、余裕は小さい。",
     "cause": "プロ列448pxでは説明全文が入らず、スタンダード列115pxは一行に必要な幅に近い。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "項目名とスタンダードの値が１行に収まり、左から右へ仕様を比較しやすい。プロの長い説明も２行に収まり、セクション行が話題の切り替わりを明確にしている。",
     "problems": "プロ列には短い値の行で余白が多いが、長い説明を読むために必要な幅であり、表全体のまとまりを損なっていない。",
     "cause": "項目列156pxとスタンダード列111pxは、それぞれ最長の１行内容と余白を収める幅で、残りの452pxをプロ列に使っている。"
    },
    {
     "design": "r2B",
     "good": "項目名と比較値が１行に収まり、セクションとデータ行の階層も明瞭。長い説明は２行で読める。",
     "problems": "プロの説明が「表示」と「時」の間で折り返され、r2Aより語のまとまりを追いにくい。広げた左２列には、その分の幅を必要とする内容がない。",
     "cause": "項目列を160px、スタンダード列を119pxに広げた分、プロ列が440pxに縮まり、説明の折り返し位置が前に移っている。"
    }
   ],
   "done": true,
   "names": [
    "r2A",
    "r2B"
   ]
  }
 },
