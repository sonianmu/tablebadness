  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "見出しがすべて一行に収まり、オプション名と短縮形も分断されない。左の二列を縦に走査し、対応する説明へ視線を移しやすい。",
     "problems": "説明列は狭く、特に最初の説明が5行になって文章のリズムが細かく途切れる。",
     "cause": "オプション列119pxと短縮形列67pxは内容を一行に収める幅だが、その結果、説明列に残るのは173pxである。"
    },
    {
     "design": "r0B",
     "good": "説明列がr0Aより広く、文章の一行あたりの文字数は増えている。短縮形も一行で読める。",
     "problems": "短縮形の見出しが二行になり、--output-dirも途中で分断される。最初の説明は依然として5行で、表全体も高くなっている。",
     "cause": "短縮形列55pxでは見出しの一行幅に足りず、オプション列104pxでも--output-dirの一行幅に足りない。説明列を200pxに広げても、最初の説明の行数を減らすには至っていない。"
    },
    {
     "design": "r0C",
     "good": "説明列が広く、文章は3案の中で最もゆったり読める。説明の行数が減り、対応する行を追いやすい。",
     "problems": "二つの見出しが折り返し、--output-dirと--configが複数行に分断される。特にオプション名を縦に探す際、識別しにくい。",
     "cause": "説明列に220pxを割り当てたため、オプション列は78px、短縮形列は61pxとなり、それぞれの見出しや長いオプション名を一行に収められない。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "オプション名と短縮形が各行でまとまり、説明も自然に折り返されている。ファイル名も分断されず、行ごとの対応を追いやすい。",
     "problems": "「短縮形」だけが2行になり、見出し行が高く、不均衡に見える。",
     "cause": "短縮形列が61pxで、見出しを1行に収める67pxに足りない。"
    },
    {
     "design": "r1B",
     "good": "オプション名と短縮形を保ち、3案の中で説明列が最も広い。",
     "problems": "「短縮形」が2行になって見出し行が高い。説明列を広げても行高はr1Aと変わらず、見出しの窮屈さが残る。",
     "cause": "短縮形列を55pxに縮めたため見出しが折り返される一方、説明列の185pxでは本文の行数を減らす閾値に達していない。"
    },
    {
     "design": "r1C",
     "good": "全見出しが1行に収まり、見出し行が引き締まっている。短縮形と説明の対応も追いやすい。",
     "problems": "最初の「--output-dir」が途中で2行に分かれ、探す対象の識別子を読み取りにくくしている。",
     "cause": "短縮形列を67pxにした一方、オプション列が114pxとなり、最長のオプション名を1行に収める119pxに足りない。"
    }
   ],
   "done": false,
   "names": [
    "r2A"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "オプション名と短縮形がそれぞれ縦に揃い、対応する説明を行単位で追いやすい。見出し、指定形、ファイル名はいずれも分割されず、表全体も画面内に収まっている。",
     "problems": "説明列が狭く、特に最初の説明は5行に分かれて行が高い。最後の説明でもファイル名が前後の文章から離れ、行内に余白が生じている。",
     "cause": "説明列173pxの本文領域は152pxしかない。一方、オプション列119pxと短縮形列67pxは、それぞれ内容と見出しを1行に保つ幅を確保している。"
    }
   ],
   "done": false,
