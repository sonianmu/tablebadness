  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "供应商、报价、交期和质保均完整呈现，表头单行，比较指标容易沿列扫描；无效投标说明也能在合并单元格中较自然地换行。",
     "problems": "评审意见被挤成很窄的文字带，频繁换行，视觉上偏重；甲、乙两行因此被大幅拉高，指标值之间出现大片空白。",
     "cause": "前四列合计占264px，评审意见列仅95px，扣除边框和内边距后只有74px容纳文字。"
    },
    {
     "design": "r0B",
     "good": "评审意见有更舒展的行长，甲、乙两行高度明显降低；供应商和报价仍保持完整。",
     "problems": "交期、质保的表头和值都拆成两行，削弱了三个并列指标的比较节奏；丙的无效投标说明也比r0A更零碎。",
     "cause": "交期列45px、质保列40px，扣除21px后分别只剩24px和19px；三列合并单元格也因这两列收窄而变窄。"
    },
    {
     "design": "r0C",
     "good": "评审意见最易连续阅读，跨行文字与甲、乙两行的高度关系较紧凑；报价仍完整。",
     "problems": "供应商名称和表头被拆开，行标识更难快速识别；交期、质保仍然拆行，丙的说明也较零碎。表格虽更短，但主要扫描路径受到损害。",
     "cause": "供应商列55px，内容区只有34px，容不下约46px的名称；交期和质保列仍分别只有45px和40px。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "表头、供应商名称、金额和质保值均保持完整；共享评审意见的跨行关系和丙公司的跨列说明都清楚。",
     "problems": "两家供应商的交期都拆成数字与“天”两行，削弱了三个指标横向比较时的行内节奏；评审意见也较窄，换行频繁。",
     "cause": "交期列52px扣除21px后仅余31px，容不下38px的交期值；评审意见列102px仅余81px文本宽度。"
    },
    {
     "design": "r1B",
     "good": "交期值保持单行，金额和供应商名称完整，跨行及跨列关系清楚。",
     "problems": "质保表头及其数值都断成两行，表头因此增高，质保列也显得局促，与相邻指标列的节奏失衡。",
     "cause": "质保列45px扣除21px后仅余24px，小于31px的表头宽度；多给交期列的宽度来自质保列。"
    },
    {
     "design": "r1C",
     "good": "供应商名称和金额完整，合并单元格关系仍然清楚。",
     "problems": "交期值和质保表头、数值均换行，同时损害数据行扫描和表头层级；相比r1A和r1B没有明显收益。",
     "cause": "交期列55px仅余34px，容不下38px的值；质保列48px仅余27px，容不下31px的表头。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "报价、交期和质保值均保持完整，三个采购指标便于横向比较；跨两行的评审意见和跨三列的无效投标说明也容易辨认。",
     "problems": "供应商表头及各供应商名称都被拆成两行，削弱了行标识的扫描速度；评审意见较窄，形成密集的多行文字。",
     "cause": "供应商列宽60px，扣除21px后只有39px文字空间，小于单行所需的46px；评审意见列宽102px，文字空间为81px。"
    },
    {
     "design": "r2B",
     "good": "与r2A相同：报价、交期和质保值完整，合并单元格的关系清楚。",
     "problems": "与r2A相同：供应商表头和名称换行，评审意见文字密集。两张渲染图没有可见差异。",
     "cause": "列宽与r2A完全相同，供应商列的39px文字空间不足以容纳46px的单行内容。"
    },
    {
     "design": "r2C",
     "good": "评审意见比r2A稍宽；报价和质保值完整，合并关系仍然清楚。",
     "problems": "供应商名称仍然换行，交期值也被拆成两行，两个并列指标行的扫描节奏因此变差；评审意见仍有较多换行。",
     "cause": "供应商列宽60px，文字空间仅39px；交期列从59px缩至52px，文字空间从38px减至31px，不足以容纳完整交期值。"
    }
   ],
   "done": false,
   "names": [
    "r3A"
   ]
  }
