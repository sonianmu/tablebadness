  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "平台名称和两级版本表头清楚；两组版本列宽接近，横向结构容易理解。",
     "problems": "v3.2 的日期和 Web 行的日期都断成两行，削弱了逐行比较；共用发布说明也较高。",
     "cause": "第 2、3、5 列分别只有 62、62、63px，扣除内边距后不足以容纳 44px 的日期；第 4、5 列合计 125px，使跨列说明需要较多行。"
    },
    {
     "design": "r0B",
     "good": "第 2、3 列的日期保持完整，iOS 和 Android 两行的 v3.2 日期易于比较；平台名称和表头也保持完整。",
     "problems": "Web 行 v3.3 的日期断行，共用发布说明仍占六行，Web 的持续部署说明也分成多行。",
     "cause": "第 5 列 60px 不足以完整容纳日期；第 4、5 列合计 119px，限制了跨列说明的行宽。"
    },
    {
     "design": "r0C",
     "good": "第 4、5 列为共用发布说明提供了较宽的空间，说明减少到五行，表格整体更紧凑；Web 行 v3.3 的日期完整。",
     "problems": "v3.2 的四个日期都断成两行，日期比较比 r0B 困难，且两版之间的列宽差异较明显。",
     "cause": "第 2、3 列各为 56px，扣除内边距后不足以容纳日期；增加第 4、5 列宽度挤占了 v3.2 的空间。"
    }
   ],
   "done": false,
   "names": [
    "r1A"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "平台名称、日期、版本号和英文名称均保持完整；两级表头清楚地区分了版本及 Beta、GA。iOS 与 Android 共用的 v3.3 说明跨行呈现，Web 行也能作为一个整体阅读。",
     "problems": "v3.3 的共用说明较拥挤，中文在“同步”和“通过后”等语义处被拆开，六行文字使 iOS 和 Android 两行明显偏高。Web 的持续部署说明也换成两行。",
     "cause": "第 4、5 列合计 119px，扣除合并单元格的内边距后，长说明的可用行宽有限；第 2、3 列合计 130px，Web 说明也不足以一行放下。可重新分配的宽度很少：第 1 列的 83px 已对应 Platform 的完整宽度，第 2、3、5 列的 65px 已对应其最长单行内容，第 4 列的 54px 则对应 Beta 的完整宽度。"
    }
   ],
   "done": true,
   "names": [
    "r1A"
   ]
  }
 },
