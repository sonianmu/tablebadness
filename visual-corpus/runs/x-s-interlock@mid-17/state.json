   "critique": [
    {
     "design": "r0A",
     "good": "“项目”及各行项目名称保持一行，左侧标签容易扫读；三个阶段的表头换行节奏一致。",
     "problems": "阶段表头逐字竖排，短词和“搭建脚手架”也被挤成竖列。两段跨列说明都很窄，行高过大，横向比较费力。",
     "cause": "第一列占55px后，阶段二和阶段三各只有44px；相邻阶段的跨列总宽分别为99px和88px。"
    },
    {
     "design": "r0B",
     "good": "阶段一和阶段二之间、阶段二和阶段三之间的跨列说明都获得较多空间，长文本块更紧凑，行与行之间的关系较容易辨认。",
     "problems": "项目名称和“项目”表头被拆成竖排；阶段表头仍逐字排列，“搭建脚手架”和测试行短词也显得拥挤。",
     "cause": "第一列只有39px，可用文字宽度不足以容纳两个汉字；阶段列宽度也大多不足以让两个汉字并排。"
    },
    {
     "design": "r0C",
     "good": "阶段二的表头能以“阶段”和数字两行呈现，“回归”也保持一行；阶段列宽度比r0A更均衡。",
     "problems": "项目名称仍逐字排列，阶段一和阶段三的表头与阶段二节奏不一致。“搭建脚手架”和其他短词仍偏窄；第一段跨列说明也比r0B更高。",
     "cause": "第一列45px不足以容纳两个汉字；阶段二和阶段三各48px，而阶段一与阶段二的合并宽度为105px，落在更费行数的换行区间。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "阶段二较宽，表头和“回归”更容易横向辨认；两段跨列说明保持为连续文本块。",
     "problems": "项目名称逐字竖排，难以快速定位行；“搭建脚手架”和“用例”也呈窄竖列，破坏行内的阅读节奏。",
     "cause": "项目列40px、阶段一51px，扣除边框和内边距后都不足以容纳两个完整汉字。"
    },
    {
     "design": "r1B",
     "good": "三个阶段宽度接近，表头的换行节奏一致；交错跨列的两段说明宽度也较均衡。",
     "problems": "项目名称仍逐字换行；阶段一的短内容和阶段二的“回归”也被拆开，整表形成多条竖排文字，横向比较吃力。",
     "cause": "项目列55px比两字的一行需求少1px；三个阶段列只有47–48px，均不足以容纳两个完整汉字。"
    },
    {
     "design": "r1C",
     "good": "阶段二获得较多空间，两段跨列说明都能受益；阶段列之间有一定的宽度区分。",
     "problems": "项目名称仍竖排，阶段一更窄使“搭建脚手架”和“用例”难以扫描；相比r1B，行高没有改善。",
     "cause": "项目列55px仍比两字的一行需求少1px；阶段一只有43px，而阶段二增加的宽度不足以改变跨列说明的行高。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "跨列说明保持连续，阶段二表头的“阶段”能够成组显示；项目列和测试行的内容也有清楚的分隔。",
     "problems": "表格很高，需求和开发两行的长说明都被挤成狭长文本块；项目名称、阶段一和阶段三的表头及短词多呈逐字竖排，横向扫描费力。",
     "cause": "项目列占55px，但其内容较短；阶段二仅48px、阶段三仅39px，使两段跨列说明可用的合计宽度偏小，阶段一的54px也未能让短文本稳定地按词成行。"
    },
    {
     "design": "r2B",
     "good": "与r2A相比，阶段二和阶段三更宽，开发行的跨列说明更紧凑，整体高度下降。",
     "problems": "阶段一的“搭建脚手架”和“用例”逐字竖排，阶段三的短词也被拆开；需求行的长说明仍然狭窄，项目列则显得偏宽。",
     "cause": "阶段一只有39px，而需求说明横跨阶段一、二；55px的项目列占用了可分配给阶段列的宽度。阶段三48px也不足以稳定容纳两个汉字。"
    },
    {
     "design": "r2C",
     "good": "项目列中的表头和项目名称在渲染中保持一行，释放出的宽度同时改善了两段跨列说明；两段说明分别降至较少行数，整表更易纵览。",
     "problems": "阶段一和阶段三的表头仍呈逐字竖排，“搭建脚手架”“用例”“冻结”和“验收”等短内容也显得零碎；阶段表头的换行节奏不一致。",
     "cause": "项目列压至39px后，中间两列各54px、末列49px；按当前渲染效果，这些阶段列仍太窄，难以稳定容纳两个汉字。总宽限制也使三个阶段都保持完整表头不可行。"
    }
   ],
