{
 "id": "x-s-interlock@mid-17",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "项目列较宽，项目标题和需求、开发、测试类别均保持一行；三个阶段列宽度接近，阶段之间的对应关系清楚。两项跨列描述分别覆盖相近宽度，长文字的换行比较均衡。",
     "problems": "三个阶段标题都竖向断成三行，削弱了表头的可读性；搭建脚手架等短词也被挤成很窄的文字列，开发行显得零碎。",
     "cause": "项目列占56px，留给各阶段列的宽度只有47–48px；扣除21px边距和边框后，每列只能容纳一个汉字。"
    },
    {
     "design": "r0B",
     "good": "三个阶段列等宽，时间结构清楚；两项跨列描述获得相同宽度，长文字的节奏一致。",
     "problems": "项目标题和三个项目类别都断成两行，行的起点不够醒目；阶段标题仍断成三行，短工作名称也显得拥挤。",
     "cause": "项目列只有39px，扣除边距和边框后仅能容纳一个汉字；每个阶段列为52px，也不足以容纳两个汉字。"
    },
    {
     "design": "r0C",
     "good": "项目类别保持完整；中间阶段列较宽，使阶段二标题和回归等短内容更易辨认，同时两项跨列描述仍有相同宽度。",
     "problems": "阶段一和阶段三标题仍各断成三行，搭建脚手架被排成单字纵列；中间列虽然较宽，阶段二标题仍需两行。",
     "cause": "第2、4列只有39px；第3列63px扣除边距和边框后只能容纳两个汉字，尚不足以让三字阶段标题完整显示。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "三列阶段中间列较宽，两处交错跨列内容都能受益，长描述各占五行，整体高度和阅读节奏优于 r1B。阶段二标题保持一行，需求、开发、测试三行也容易区分。",
     "problems": "项目类别和两个外侧阶段标题逐字竖排；“搭建脚手架”等短内容也被挤成长竖列，削弱了横向扫读。",
     "cause": "第1、2、4列各为40px，扣除21px后只剩19px文字宽度，基本只能容纳一个汉字；第3列78px则为相邻两处跨列内容提供了共同的宽度。"
    },
    {
     "design": "r1B",
     "good": "第1列较宽，类别区域更从容；三个阶段列的宽度差异较小。",
     "problems": "四个标题仍全部换行，两处长描述显著变高，表格比 r1A 高79px。开发行中“搭建脚手架”仍逐字竖排，行内各单元格的文字分布也较零散。",
     "cause": "第1列55px扣除边框和内边距后只有34px，略不足以容纳约35px的“项目”；第3列从78px减至55px，同时压缩了两处跨列单元格，而第2列仍只有40px。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "中间阶段列较宽，两处跨列描述都控制在五行；两条长描述形成相近的行高，表格整体较紧凑。",
     "problems": "项目类别和所有阶段标题都发生换行；第一阶段的“搭建脚手架”逐字竖排，难以作为一个工作名称快速识别。",
     "cause": "第1、4列各40px、第2列48px，扣除21px边距和边框后，分别只剩19px、19px和27px的文字宽度；第3列占70px，使其他列更局促。"
    },
    {
     "design": "r2B",
     "good": "两处跨列描述仍各为五行，需求和开发两行的高度一致；末列比r2A稍宽。",
     "problems": "项目类别和所有阶段标题仍然换行；第一阶段更窄，“搭建脚手架”逐字竖排，末列增加的宽度也不足以让三字阶段标题保持一行。",
     "cause": "第1、2列各40px，只剩19px文字宽度；第4列48px只剩27px，仍容不下三字标题。第3列70px继续占用了较多宽度。"
    },
    {
     "design": "r2C",
     "good": "第1列让“项目”和需求、开发、测试类别保持一行，行首更容易辨认；阶段列的角色也更清楚。",
     "problems": "两处长描述明显变窄，需求行达到七行、开发行也更高，表格拉长；第一和第三阶段标题仍逐字换行，“搭建脚手架”也逐字排列。",
     "cause": "第1列增至56px后，第2、4列各压到40px，第3列降至62px；两个跨列区域都只有102px，扣除其两列的边距和边框后，长描述的可用宽度减少。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B",
    "r3C"
   ]
  }
