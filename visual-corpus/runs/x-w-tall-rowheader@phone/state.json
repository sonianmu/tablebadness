  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "四个列标题和数值均保持完整；目标值与实际值宽度相近，便于横向比较。多数指标占两行，行高节奏较稳定。",
     "problems": "第三项指标的“例”单独落在第二行，形成明显的孤字；前两项的括号说明也被拆开，阅读稍有停顿。",
     "cause": "指标列宽169px，可用文字宽度148px，略不足以容纳第三项完整名称，也不足以让较长的括号说明完整排列。"
    },
    {
     "design": "r0B",
     "good": "指标列较宽，第三项完整占一行，指标名称的阅读更顺畅。",
     "problems": "“目标值”和“实际值”标题各占两行；首行的金额单位“亿”被挤到下一行，“≤ 12%”也被拆开，削弱了数值的完整性和比较效率。",
     "cause": "指标列扩大到185px后，目标值列仅54px、实际值列仅66px；扣除21px的内边距和边框后，标题及部分数值没有足够空间。"
    },
    {
     "design": "r0C",
     "good": "标题和数值均保持完整；目标值与实际值有充足空间，成对关系清楚。",
     "problems": "第二项指标占三行，第三项断行也较生硬；数据列中的多余空白使指标列显得局促，行高节奏不均。",
     "cause": "指标列仅145px，可用文字宽度124px；目标值和实际值列分别达到76px和78px，占用了指标名称更需要的宽度。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "指标列较宽，第三项指标保持一行；权重和大多数数值完整，目标值与实际值两列的分量也相近。",
     "problems": "目标值和实际值的表头都断成两行，首行的“2.61 亿”也被拆开，削弱了表头识别和横向比较。",
     "cause": "目标值列为65px、实际值列为66px，扣除各21px内边距与边框后，均不足以容纳对应表头；实际值列也不足以容纳完整金额。"
    },
    {
     "design": "r1B",
     "good": "指标列略宽，第三项指标保持一行，目标值与实际值列的宽度相近。",
     "problems": "两个比较列表头仍然断行；首行金额和第二行的“94.5%”也被拆开，数值阅读尤其不顺畅。",
     "cause": "实际值列只有65px，比r1A更窄，扣除21px后可用文本宽度不足；目标值列64px也不足以容纳完整表头。"
    },
    {
     "design": "r1C",
     "good": "实际值表头和“94.5%”保持完整，两列比较数据的视觉分量相近。",
     "problems": "目标值表头和首行金额仍断行；第三项指标末尾只有一个“例”落在第二行，形成突兀的短行并增加行高。",
     "cause": "目标值列66px仍略窄；实际值列67px不足以容纳完整金额。指标列缩至172px后，第三项指标刚好无法放在一行。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "四个表头和数值均保持完整；目标值与实际值两列宽度相近，便于横向比较。长指标分两行后，同一行的数据仍容易对应。",
     "problems": "第三项指标末尾的“例”单独占一行，显得零碎；第二项的括号说明也被拆到两行。",
     "cause": "首列为169px，文本可用宽度148px，略不足以让第三项指标完整排在一行。其余三列已接近容纳表头和完整数值所需的宽度，难以再为首列腾出空间。"
    },
    {
     "design": "r2B",
     "good": "表头完整，目标值与实际值的列宽仍然接近；各行数据的对应关系清楚。",
     "problems": "第一行实际值中的“亿”落到下一行，金额被拆开；首列增加1px也未消除第三项指标的单字尾行。",
     "cause": "实际值列由69px缩至68px，文本可用宽度降至47px，小于该金额约48px的一行宽度；首列170px仍不足以容纳第三项指标。"
    }
   ],
   "done": true,
   "names": [
    "r2A",
    "r2B"
   ]
  }
