{
 "id": "x-ja-mixed-code@desktop",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "オプション名と短縮形がそれぞれ一行に収まり、識別子から説明へ視線を移しやすい。最初の説明だけが二行になり、表全体の行のまとまりも明瞭。",
     "problems": "説明の二行目は短めだが、意味の流れは追いやすく、大きな欠点ではない。",
     "cause": "第1列119pxは最長のオプション名に必要な幅を確保し、第3列533pxが説明に十分な余地を与えている。"
    },
    {
     "design": "r0B",
     "good": "説明欄が広く、短縮形と説明は読みやすい。",
     "problems": "最初のオプション名が「--output-」と「dir」に分かれ、縦に識別子を探す際に読み取りにくい。",
     "cause": "第1列100pxのテキスト領域は79pxで、オプション名の一行幅98pxに足りない。"
    },
    {
     "design": "r0C",
     "good": "識別子と短縮形が一行に収まり、列の区別も明瞭。最初の説明の二行は比較的均衡している。",
     "problems": "識別子の二列に余白が多く、説明欄が窮屈に見える。最初の説明は「存在しない」と「場合は」の間で折り返され、読みのまとまりがやや弱い。",
     "cause": "第1列145pxと第2列80pxが必要以上に幅を取り、第3列が494pxに縮んでいる。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "識別子と短縮形を隣接させ、対応する説明を同じ行で追いやすい。見出しとコード表記がすべて分割されず、長い説明だけが自然に２行になる。",
     "problems": "短縮形の見出しはセル幅に対して余裕が少なく、右側の罫線に近い。",
     "cause": "短縮形列の67pxは、見出しの１行幅46pxとパディング・罫線21pxをちょうど収める幅。"
    },
    {
     "design": "r1B",
     "good": "オプション名、短縮形、ファイル名は分割されず、説明にも広い幅を確保できている。",
     "problems": "短縮形の見出しだけが２行になり、ヘッダー行が高くなる一方、説明の折り返しはr1Aと変わらない。",
     "cause": "短縮形列を63pxに縮めたため、テキスト領域が42pxとなり、見出しの１行幅46pxに足りない。"
    }
   ],
   "done": false,
   "names": [
    "r2A"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "オプション名と短縮形が隣接し、どちらも一行で縦に探せる。説明列に十分な幅があり、長い説明だけが二行になるため、各行の対応も追いやすい。表はビューポート内に収まっている。",
     "problems": "最初の説明は二行目が「は」で始まり、文の区切りとしてやや不自然に見える。",
     "cause": "説明列529pxでは「場合は」を一行目に収める余裕がない。一方、識別子の列は見出しや内容を一行に保つためにほぼ必要な幅を使っており、そこから移せる幅は限られる。"
    }
   ],
   "done": true,
   "names": [
    "r2A"
   ]
  }
 },
