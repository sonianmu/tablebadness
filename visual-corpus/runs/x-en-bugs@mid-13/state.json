{
 "id": "x-en-bugs@mid-13",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "All five short columns—ID, Severity, Assignee, Status and Updated—stay on one line, with no header wraps and no mid-word splits. The table is compact at 314px and the metadata reads cleanly.",
     "problems": "The Title column is visually starved: four of six titles wrap to two lines, so rows alternate 33/53px and the primary scan anchor becomes ragged. The table reads as metadata-first rather than issue-first.",
     "cause": "Title is 224px, leaving only 203px of text against a 349px one-line requirement. However, this is already the maximum possible title width after reserving the exact one-line minima for the other columns: 87+73+79+89+98 = 426px."
    },
    {
     "design": "r0B",
     "good": "Title gains 14px over r0A, and the table height remains 314px. The narrower Status column creates a tighter overall grid.",
     "problems": "Status phrases now break: “In progress” wraps to two lines in several rows. Title still wraps in the same four rows, so there is no row-height saving—only extra fragmentation inside cells.",
     "cause": "Status is 75px, below the 89px needed for “In progress” on one line. The 14px transferred to Title raises it to 238px, still far short of the width needed to bring any wrapped title down to one line."
    },
    {
     "design": "r0C",
     "good": "The metadata columns are comfortable, Status remains intact, and the wider Assignee/Severity columns reduce any sense of crowding there.",
     "problems": "Title is the weakest element: one row grows to three lines and the table becomes 334px tall. Row heights are highly uneven, and the surplus space in metadata columns is wasted while the main reading column is compressed.",
     "cause": "Title is only 200px, leaving 179px of text. Meanwhile Severity (79px), Assignee (90px) and Status (96px) exceed their one-line minima by about 24px total—space that should have gone to Title."
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
