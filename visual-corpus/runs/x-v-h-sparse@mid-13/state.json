  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "Host, role, zone, CPU and status values remain intact, making the ordinary rows compact and easy to compare. The notes column has enough width to keep the exception readable without splitting words.",
     "problems": "The long note makes its row much taller than the others and leaves substantial empty space in the neighboring cells.",
     "cause": "The 263px Notes column wraps the exceptional entry into six lines. The other columns are already at the stated widths needed to keep their contents on one line, so giving Notes more space would compromise those values."
    },
    {
     "design": "r0B",
     "good": "The 283px Notes column reduces the exceptional note to five lines and gives it a comfortable reading width. Host, role, CPU and status values remain intact.",
     "problems": "Every zone identifier wraps, making all ordinary rows taller and interrupting comparisons down the Zone column. The additional height outweighs the space saved in the exception row.",
     "cause": "At 70px, Zone has only 49px for text, less than the 69px needed for a one-line identifier. The 20px transferred to Notes is taken from a column repeated in every row."
    },
    {
     "design": "r0C",
     "good": "The identification and operational columns have generous breathing room, and their values stay on one line. The table remains easy to scan across ordinary rows.",
     "problems": "The note becomes a narrow seven-line block, making the exception row taller and increasing the empty space beside it. The extra width in the short-value columns provides little additional benefit.",
     "cause": "Host, Role, Zone, CPU and Status receive more width than their one-line contents require, leaving only 213px for Notes."
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
