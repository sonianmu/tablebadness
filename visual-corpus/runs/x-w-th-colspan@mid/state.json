    {
     "design": "r0A",
     "good": "สัดส่วนโดยรวมสมดุลพอสมควร ราคาทั้งสองคอลัมน์อยู่ใกล้กันและตัวเลขอ่านเทียบในแต่ละแถวได้ง่าย รายการสิ่งอำนวยความสะดวกไม่สูงเกินสามบรรทัด",
     "problems": "หัวข้อวันธรรมดาแตกเป็นสองบรรทัด และชื่อห้องดีลักซ์วิวทะเลแตกบรรทัด ทำให้ชื่อห้องอ่านสะดุด",
     "cause": "คอลัมน์ 2 กว้าง 78px เหลือพื้นที่ข้อความ 57px ซึ่งน้อยกว่าความกว้างหัวข้อ 67px ส่วนคอลัมน์ 1 กว้าง 119px เหลือ 98px ซึ่งไม่พอสำหรับชื่อที่ยาว 108px"
    },
    {
     "design": "r0B",
     "good": "คอลัมน์สิ่งอำนวยความสะดวกกว้างที่สุดในสามแบบ จึงจัดรายการได้โปร่งและอ่านต่อเนื่อง ราคายังคงอยู่ในแถวเดียวกัน",
     "problems": "ชื่อห้องทั้งสองแตกเป็นหลายบรรทัด ทำให้จุดเริ่มต้นในการค้นหาและเปรียบเทียบห้องอ่านยากขึ้น หัวข้อวันธรรมดายังแตกบรรทัด แม้ความสูงรวมของตารางไม่ลดลงจาก r0A",
     "cause": "คอลัมน์ 1 กว้างเพียง 95px เหลือพื้นที่ข้อความ 74px ขณะที่คอลัมน์ 2 กว้าง 74px เหลือ 53px โดยพื้นที่ที่ย้ายไปคอลัมน์ 4 ไม่ได้ลดจำนวนบรรทัดสูงสุดของแถว"
    },
    {
     "design": "r0C",
     "good": "ชื่อห้องทั้งสองอยู่บรรทัดเดียวกัน คอลัมน์ราคามีความกว้างใกล้กันและตัวเลขแยกจากรายละเอียดชัดเจน",
     "problems": "รายการสิ่งอำนวยความสะดวกแคบและแตกหลายบรรทัด ทำให้แถวสูงขึ้นมากและจังหวะตารางยืดยาว หัวข้อวันธรรมดายังแตกบรรทัด",
     "cause": "คอลัมน์ 4 กว้างเพียง 156px เหลือพื้นที่ข้อความ 135px ส่วนคอลัมน์ 2 กว้าง 85px เหลือ 64px ซึ่งยังขาดอีก 3px สำหรับหัวข้อวันธรรมดา"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "ชื่อห้องทั้งสองอยู่บรรทัดเดียว และรายการสิ่งอำนวยความสะดวกแบ่งได้โดยไม่ตัดกลางคำ ราคาทั้งสองยังเปรียบเทียบตามแถวได้ง่าย",
     "problems": "หัวข้อวันธรรมดาแตกเป็นสองบรรทัด ทำให้หัวตารางสูงและจังหวะของหัวข้อราคาสองคอลัมน์ไม่เท่ากัน",
     "cause": "คอลัมน์ 2 กว้าง 78px เหลือพื้นที่ข้อความ 57px ซึ่งไม่พอสำหรับหัวข้อวันธรรมดาในบรรทัดเดียว"
    },
    {
     "design": "r1B",
     "good": "หัวข้อทั้งหมดอยู่บรรทัดเดียว หัวตารางจึงกระชับและราคาสองประเภทเทียบกันได้ชัด คอลัมน์สิ่งอำนวยความสะดวกกว้างที่สุดในสามแบบ ทำให้ข้อความกระจายตัวได้ดี",
     "problems": "ชื่อห้องดีลักซ์วิวทะเลขึ้นสองบรรทัด ขณะที่ชื่อห้องอีกประเภทอยู่บรรทัดเดียว แต่ยังอ่านเป็นหน่วยเดียวกันได้",
     "cause": "คอลัมน์ 1 กว้าง 115px เหลือพื้นที่ข้อความ 94px น้อยกว่าความกว้างบรรทัดเดียวของชื่อห้องที่ยาวที่สุด"
    },
    {
     "design": "r1C",
     "good": "ชื่อห้องและหัวข้อทั้งหมดอยู่บรรทัดเดียว ทำให้ค้นหาประเภทห้องและอ่านหัวตารางได้ง่าย",
     "problems": "สิ่งอำนวยความสะดวกแตกหลายบรรทัด โดยแถวสุดท้ายสูงถึงสี่บรรทัดและมีคำสั้น ๆ อยู่บรรทัดท้าย ทำให้ตารางสูงและพื้นที่ในคอลัมน์ราคาโล่งมาก",
     "cause": "คอลัมน์ 1 กว้าง 129px และคอลัมน์ 2 กว้าง 88px จึงเหลือให้คอลัมน์ 4 เพียง 169px หรือพื้นที่ข้อความ 148px"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B",
    "r2C"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "โดยรวมอ่านและเปรียบเทียบราคาได้ดีที่สุด หัวข้อราคาทั้งสองอยู่บรรทัดเดียว ตัวเลขเรียงชัด และรายละเอียดห้องใช้เพียงสองถึงสามบรรทัด",
     "problems": "ชื่อห้องดีลักซ์วิวทะเลขึ้นสองบรรทัด ทำให้ชื่อห้องสะดุดเล็กน้อย แต่ยังอ่านเป็นหน่วยเดียวกันได้",
     "cause": "คอลัมน์ประเภทห้องกว้าง 112px ไม่พอให้ชื่อยาวอยู่บรรทัดเดียว ขณะที่คอลัมน์สิ่งอำนวยความสะดวกกว้าง 186px ช่วยให้รายละเอียดกระจายตัวได้ดีกว่าแบบอื่น"
    },
    {
     "design": "r2B",
     "good": "ชื่อห้องทั้งสองอยู่บรรทัดเดียว จึงกวาดสายตาหาประเภทห้องได้ง่าย",
     "problems": "หัวข้อวันหยุดแยกเป็นสองบรรทัด ทำให้ส่วนหัวสูงและเสียจังหวะเมื่อเทียบกับวันธรรมดา รายละเอียดห้องดีลักซ์ยาวถึงสี่บรรทัดและมีคำสั้นอยู่ท้ายแถวเพียงลำพัง",
     "cause": "คอลัมน์ประเภทห้องกว้าง 129px แต่คอลัมน์วันหยุดเหลือ 61px และสิ่งอำนวยความสะดวกเหลือ 175px จึงเกิดการตัดบรรทัดในสองตำแหน่งนั้น"
    },
    {
     "design": "r2C",
     "good": "หัวข้อราคาทั้งสองอยู่บรรทัดเดียว และส่วนหัวมีความสูงกะทัดรัด ชื่อห้องดีลักซ์ยังอ่านต่อเนื่องได้แม้ขึ้นสองบรรทัด",
     "problems": "รายละเอียดห้องดีลักซ์กระจายเป็นสี่บรรทัด โดยมีคำสั้นอยู่บรรทัดสุดท้าย ทำให้แถวสูงกว่า r2A โดยไม่ได้ช่วยให้ชื่อห้องอยู่บรรทัดเดียว",
     "cause": "คอลัมน์ประเภทห้องกว้าง 121px ยังไม่พอสำหรับชื่อยาว แต่ใช้พื้นที่เพิ่มจาก r2A ทำให้คอลัมน์สิ่งอำนวยความสะดวกเหลือ 177px"
    }
   ],
   "done": false,
   "names": [
