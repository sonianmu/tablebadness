 "id": "x-w-ar-multi@phone",
 "steps": {
  "r0": {
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "أسماء المحافظات والترويسات والأعداد سليمة، وعمودا العدد متساويان ومتجاوران تحت ترويستهما المشتركة.",
     "problems": "الملاحظتان طويلتان بصرياً، وتتركان مساحات بيضاء كبيرة بجانب الأعداد داخل صفي القاهرة وأسوان.",
     "cause": "إعطاء كل عمود من عمودي العدد 75px يحجز مساحة أكبر مما يحتاجه محتواه، ويترك 123px فقط للملاحظات."
    },
    {
     "design": "r0B",
     "good": "أفضل التصاميم توازناً: تبقى الترويسات والأسماء والأعداد سليمة، وتقرأ الملاحظات في أسطر أقل، فتبدو الصفوف أكثر تماسكا. يظل عمودا العدد متجاورين وواضحي الانتماء إلى الترويسة المشتركة.",
     "problems": "عمود الخاصة أضيق من عمود الحكومية، لذلك إيقاع العمودين أقل توازناً قليلاً؛ لكنه فرق مقبول بالنظر إلى اختلاف عرض الترويستين.",
     "cause": "العرضان 69px و58px يطابقان الحد اللازم لاحتواء أطول كلمة في كل عمود، ويوفران 146px للملاحظات."
    },
    {
     "design": "r0C",
     "good": "أسماء المحافظات واضحة ولها مساحة مريحة، ويحتفظ عمودا العدد بتقارب بصري.",
     "problems": "تتقطع الملاحظات إلى أسطر قصيرة كثيرة، خاصة في صف القاهرة، فتطول الصفوف وتبدو مساحات الأعداد فارغة نسبياً.",
     "cause": "تخصيص 100px للمحافظة و145px لعمودي العدد يترك 114px فقط للملاحظات، رغم أن عرض المحافظة المطلوب هو 86px."
    }
   ],
   "done": false,
   "names": [
    "r1A"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "يظهر اتجاه القراءة بوضوح من المحافظة يمينًا إلى العددين المتجاورين ثم الملاحظات. الترويسات سليمة، والأعداد سهلة المقارنة، والكلمات لا تنقسم داخلها. اختلاف ارتفاع الصفوف يتبع طول الملاحظات، مع بقاء كل صف واضحًا كوحدة.",
     "problems": "تحتل ملاحظة القاهرة ثلاثة أسطر وتجعل صفها أطول من غيره بوضوح. ويبدو عمود المدارس الخاصة أضيق قليلًا من العمود الحكومي، وإن كان كلاهما يستوعب محتواه.",
     "cause": "عرض الملاحظات 144px يترك 123px للنص، فيفرض التفاف الجملة الطويلة. وعرض العمودين العدديين 69px و60px يتبع اختلاف عرض ترويستيهما؛ ولا يتبقى مجال كبير لتوسيع الملاحظات دون التضحية بالكلمات السليمة."
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "يُظهر المحافظة بوضوح على اليمين، ويجمع نوعَي المدارس تحت ترويسة مشتركة. الأعداد والكلمات سليمة، وتبقى الملاحظة الأخيرة في سطرين، فتُقرأ الصفوف كوحدات متماسكة.",
     "problems": "عمودا العدد غير متساويين بصرياً، والملاحظة الأولى تشغل ثلاثة أسطر، لكن الإيقاع العام واضح.",
     "cause": "يحتاج عمود الحكومية إلى 69 بكسل لاستيعاب ترويسته، مقابل 58 للخاصة. وتتيح 146 بكسل للملاحظات أكبر مساحة ممكنة مع إبقاء الكلمات في الأعمدة الأخرى سليمة."
    },
    {
     "design": "r2B",
     "good": "يمنح عمودَي العدد إيقاعاً أكثر تقارباً، مع ترويسات وأعداد سليمة.",
     "problems": "تلتف الملاحظة الأخيرة إلى ثلاثة أسطر، فيزداد ارتفاع صف أسوان ويضعف إيقاع الجدول مقابل تحسن طفيف في توازن عمودَي العدد.",
     "cause": "خفض عرض الملاحظات من 146 إلى 141 بكسل لإضافة مساحة إلى عمودَي العدد يغيّر موضع التفاف النص الأخير."
    }
   ],
   "done": true,
   "names": [
    "r2A",
    "r2B"
   ]
  }
 },
