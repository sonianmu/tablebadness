  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "参数名、类型、必填值和默认值均保持完整；说明列较宽，五个数据行的说明都控制在三行以内，横向对应关系清楚。",
     "problems": "说明仍较拥挤，排序字段的代码标识符占据多行；参数名与默认值列中较短内容旁有较多空白。",
     "cause": "前四列合计407px，已接近保持最长内容完整所需的宽度，留给说明列216px。"
    },
    {
     "design": "r0B",
     "good": "参数名列留有充裕空间，所有标识符和表头完整，字段及其约束容易定位。",
     "problems": "参数名列的额外空白没有改善读取，却使多条说明增至四行，行高增加，横向比较也更费力。",
     "cause": "参数列从160px增至180px，说明列相应缩至196px。"
    },
    {
     "design": "r0C",
     "good": "类型、必填和默认值列较宽，短值周围较疏朗，表头和代码值均完整。",
     "problems": "约束列的留白与密集的说明列失衡；多条说明增至四行，中文短语与代码值被切成较短的片段。",
     "cause": "类型、必填和默认值列分别增至85、66和128px，使说明列缩至184px。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "参数名、类型、必填值和默认值均保持完整，表头处于同一行；说明列自然换行，每行的字段与解释对应清楚。列宽随内容作用分配，便于先定位参数，再横向查阅约束和用途。",
     "problems": "说明列较窄，长说明需要三行，表格因此较高；部分中文短语在行尾被拆开。",
     "cause": "说明列为216px，扣除内边距和边框后仅有195px文本空间。其他列已接近保持最长标识符和表头完整所需的最小宽度，难以在624px视口内进一步扩展说明列。"
    },
    {
     "design": "r1B",
     "good": "参数名、类型、默认值及说明中的代码标识符保持完整；说明列比r1A宽3px。",
     "problems": "“必填”表头被拆成两行，表头明显高于其他列，破坏横向节奏；说明列增加的空间没有减少正文行高，整表反而更高。",
     "cause": "必填列从56px缩至53px，扣除21px后只剩32px，小于“必填”所需的35px；转给说明列的3px不足以产生有价值的换行改善。"
    }
   ],
   "done": true,
   "names": [
    "r1A",
    "r1B"
   ]
  }
 },
