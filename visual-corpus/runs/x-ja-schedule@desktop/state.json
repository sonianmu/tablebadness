   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "日付、時間、会場がそれぞれ一行に収まり、開催枠を縦に探して内容へ目を移しやすい。短いパネルディスカッションの行は低く、内容の長さに応じた行のリズムもある。",
     "problems": "長い内容は二行になり、基調講演では末尾の短い語句が二行目に残る。会場列には多少の余裕があり、内容列に回せる可能性がある。",
     "cause": "内容列389pxに対し、会場列97pxは最長の一行幅と余白を収める幅に近い。会場名を保てる範囲で幅を調整すれば、内容の折り返し位置を改善できる可能性がある。"
    },
    {
     "design": "r0B",
     "good": "内容列が広く、基調講演やハンズオンの文章をより長いまとまりで読める。列見出しはすべて一行に収まる。",
     "problems": "全行で日付と時間が二行になり、展示ホールも分断される。短いパネルディスカッションの行まで高くなり、日時を比較する視線も上下に散る。",
     "cause": "日付100px、時間100px、会場85pxでは、それぞれの一行に必要な幅を確保できない。内容列へ移した幅によって、開催枠を探すための列に折り返しが生じている。"
    },
    {
     "design": "r0C",
     "good": "内容列が最も広く、基調講演は一行に収まる。長い説明も比較的長いまとまりで読める。",
     "problems": "日付と時間は全行で二行になり、会場名も複数行に割れる。会議室の記号やホール名が離れ、会場の判別と横方向の対応づけがしにくい。短い内容の行にも大きな高さが生じる。",
     "cause": "日付85px、時間85px、会場70pxが一行表示に必要な幅を下回り、内容列479pxを確保した分だけ左側の三列が窮屈になっている。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "日付、時間、会場がすべて１行に収まり、開催枠を縦に探して同じ行の内容へ視線を移しやすい。内容も最大２行で、短いプログラムの行には適度な余白がある。",
     "problems": "内容の長い文では「コードベース」などが行をまたぎ、最初の講演も文の途中で折り返される。",
     "cause": "内容列が389pxのため、長い題目や説明は途中で折り返される。ただし、他の３列はいずれも１行を保つために必要な幅に近い。"
    },
    {
     "design": "r1B",
     "good": "日付と時間は１行で揃い、内容列も最大２行に収まっている。",
     "problems": "最終行の「展示ホール」が２行に分かれ、会場名を縦に比較しにくい。内容列を広げた効果も目立たない。",
     "cause": "会場列を94pxに狭めたことで、表示領域が会場名の１行幅に足りなくなっている。"
    },
    {
     "design": "r1C",
     "good": "会場名は１行に収まり、内容列に３案で最も広い幅を割いている。",
     "problems": "すべての時間帯が２行に分かれ、開始・終了時刻をまとめて読み取りにくい。短いパネルディスカッションの行も時間の折り返しで高くなり、行のリズムが崩れる。",
     "cause": "時間列が100pxでは時間帯の１行幅に足りず、内容列に移した幅も内容の行数を減らすには至っていない。"
    }
   ],
   "done": true,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
 },
