    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "The Russian terms and Vietnamese equivalents each stay on one line, making the terminology pairs easy to scan. The descriptions wrap naturally, and the rows remain clear units.",
     "problems": "The first description takes three lines, leaving some white space beside the shorter terminology pair, but the row remains easy to read.",
     "cause": "The 280px description column must accommodate substantially longer prose than the other columns."
    },
    {
     "design": "r1B",
     "good": "The Russian terms remain intact, and the descriptions have slightly more room.",
     "problems": "Two Vietnamese equivalents wrap, weakening the quick visual pairing with the Russian terms. The added description width does not reduce any row height.",
     "cause": "The 121px Vietnamese column provides only 100px for text, less than the 111px needed by the longest equivalent."
    },
    {
     "design": "r1C",
     "good": "The Russian terms remain intact, and the description column is the widest of the three designs.",
     "problems": "Two Vietnamese equivalents wrap, while the descriptions and row heights show no corresponding improvement. The terminology pair is less compact to scan than in r1A.",
     "cause": "The 115px Vietnamese column provides 94px for text; the extra width given to the description column does not change the observed line counts."
    }
   ],
