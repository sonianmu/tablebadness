  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "ส่วนหัวและชื่อสายกับสถานีอยู่ในบรรทัดเดียว ต้นทางและปลายทางอ่านเป็นคู่ได้ชัด และหมายเหตุสามบรรทัดใช้พื้นที่ของเซลล์ที่คร่อมสองแถวได้พอดี",
     "problems": "หมายเหตุค่อนข้างแคบเมื่อเทียบกับความยาวข้อความ จึงมีจังหวะขึ้นบรรทัดถี่ แต่ภาพรวมยังสมดุลและอ่านได้ดีที่สุดในสามแบบ",
     "cause": "คอลัมน์หมายเหตุกว้าง 184px ขณะที่สามคอลัมน์แรกใช้ความกว้างรวม 295px"
    },
    {
     "design": "r0B",
     "good": "หมายเหตุกว้างขึ้น ทำให้ข้อความต่อเนื่องแต่ละบรรทัดอ่านได้ยาวขึ้น",
     "problems": "หัวปลายทางและชื่อหลายรายการขึ้นสองบรรทัด ทำให้แถวสูงขึ้นและจับคู่ต้นทางกับปลายทางได้ยากขึ้น ชื่อสายที่คร่อมสองแถวก็กระจายเป็นสองบรรทัด",
     "cause": "คอลัมน์สาย ต้นทาง และปลายทางกว้างเพียง 86, 86 และ 78px ตามลำดับ เพราะจัดสรรให้หมายเหตุถึง 229px"
    },
    {
     "design": "r0C",
     "good": "หัวตารางอยู่บรรทัดเดียว และต้นทางกับปลายทางมีความกว้างเท่ากัน ช่วยแสดงความสัมพันธ์ของข้อมูลคู่นี้",
     "problems": "ชื่อสายทั้งสองและชื่อต้นทางหนึ่งรายการขึ้นสองบรรทัด ทำให้จังหวะแถวไม่สม่ำเสมอและตารางสูงกว่า r0A ทั้งที่หมายเหตุยังมีสามบรรทัด",
     "cause": "คอลัมน์สายกว้าง 94px และต้นทาง 100px ซึ่งต่ำกว่าความกว้างหนึ่งบรรทัดรวม padding ของเนื้อหาที่ยาวที่สุดในแต่ละคอลัมน์ ส่วนปลายทางได้ 100px มากกว่าที่จำเป็นสำหรับเนื้อหาหนึ่งบรรทัด"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "ชื่อสาย สถานี และหัวตารางอยู่ครบในบรรทัดเดียว ต้นทางกับปลายทางอ่านเทียบกันได้ง่าย และหมายเหตุใช้พื้นที่คร่อมสองแถวได้พอดี",
     "problems": "ตารางกว้างเกินขีดจำกัดที่กำหนด 1px",
     "cause": "ความกว้างรวมของคอลัมน์เป็น 479px แต่ความกว้างตารางที่แสดงจริงเป็น 480px"
    },
    {
     "design": "r1B",
     "good": "ลำดับชั้นและจังหวะการอ่านชัดเจน ชื่อสถานีอยู่ครบ และหมายเหตุแบ่งเป็นสามบรรทัดโดยไม่ตัดกลางคำ",
     "problems": "ตารางกว้างเกินขีดจำกัดที่กำหนด 1px โดยคอลัมน์ปลายทางที่กว้างขึ้นไม่ได้ทำให้ผลที่มองเห็นดีขึ้น",
     "cause": "ความกว้างรวมของคอลัมน์เป็น 479px แต่ความกว้างตารางที่แสดงจริงเป็น 480px; การเพิ่มคอลัมน์ปลายทางจาก 89 เป็น 90px ลดพื้นที่หมายเหตุลง 1px"
    },
    {
     "design": "r1C",
     "good": "ตารางอยู่ในขีดจำกัด ชื่อสาย สถานี และหัวตารางอยู่ครบในบรรทัดเดียว คู่ต้นทาง–ปลายทางอ่านเทียบกันง่าย และหมายเหตุสามบรรทัดอยู่ภายในความสูงของสองแถวที่คร่อมอย่างเป็นระเบียบ",
     "problems": "ไม่พบปัญหาที่แก้ได้อย่างมีนัยสำคัญด้วยการปรับความกว้างเพียงอย่างเดียว",
     "cause": "สามคอลัมน์แรกมีความกว้างพอดีกับเนื้อหาแบบบรรทัดเดียว ส่วนพื้นที่ที่เหลือจัดให้หมายเหตุ"
    }
   ],
   "done": true,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  }
