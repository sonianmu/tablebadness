  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "两个方案列等宽，比较条件一致；三个维度清晰，表头完整。各行最多两行，横向比较时容易保持视线。",
     "problems": "合规行两侧均为单行，阅读节奏紧凑；成本和运维行的换行也较均衡，但首列相对文字略宽，可考虑把少量空间留给说明。",
     "cause": "首列为61px，两方案列各329px；说明列空间均衡，但首列文字仅需约31px加内边距。"
    },
    {
     "design": "r0B",
     "good": "方案A较宽，说明文字舒展；维度和表头均完整。",
     "problems": "方案B的成本说明折成三行，合规说明也折成两行，而同一行的方案A较短，留下明显空白；两种方案的比较节奏失衡。",
     "cause": "首列79px占用较多空间，方案B仅250px，而方案A达到390px。"
    },
    {
     "design": "r0C",
     "good": "首列紧凑，方案B文字舒展；表头和维度名称完整。",
     "problems": "方案A的成本说明折成三行，合规说明折成两行；方案B同一行较短，空白偏多，两列阅读条件失衡。",
     "cause": "方案A仅270px，方案B却有394px；相同角色的两列宽度差距过大。"
    }
   ],
   "done": false,
   "names": [
    "r1A",
    "r1B",
    "r1C"
   ]
  },
  "r2": {
   "critique": [
    {
     "design": "r1A",
     "good": "两个方案列等宽，比较关系清楚；三个维度名称完整，同一行的内容容易横向对照。合规行两侧均为一行，整表节奏紧凑。",
     "problems": "运维行的托管服务说明末尾只剩“置。”落在第二行，形成明显的短尾。",
     "cause": "方案B列宽332px，正文可用宽度311px，略不足以容纳运维说明第一行末尾的“置。”。"
    },
    {
     "design": "r1B",
     "good": "两个方案列仍然相近，成本和运维两行都能清楚地横向比较，表头和维度名称完整。",
     "problems": "合规行的方案B说明以“险。”单独收尾，造成短尾和较大的行内空白；运维行也有短尾。",
     "cause": "方案B列收窄至324px，使合规说明末尾换行；增加给方案A的宽度没有抵消这一损失。"
    },
    {
     "design": "r1C",
     "good": "方案B的合规说明保持一行，两个方案列仍有相近的阅读条件。",
     "problems": "合规行的方案A说明以“求。”单独收尾；运维行的方案B说明仍有短尾。合规行因此出现较多空白。",
     "cause": "方案A列收窄至324px，使“要求。”在行末被拆开；方案B列增至340px仍不足以消除运维说明的短尾。"
    }
   ],
   "done": false,
   "names": [
    "r2A",
    "r2B"
   ]
  },
  "r3": {
   "critique": [
    {
     "design": "r2A",
     "good": "维度列紧凑且名称完整，两种方案的列宽接近，便于逐行横向比较；表头清晰，成本和运维行的高度一致。",
     "problems": "方案B的运维说明将“配置”拆开，第二行只剩一个“置”，形成醒目的孤字，也削弱了该行的阅读节奏。",
     "cause": "方案B列宽337px，扣除21px后正文可用316px，首行恰好容不下“配置”的最后一个字。"
    },
    {
     "design": "r2B",
     "good": "两种方案几乎等宽，比较关系清楚；维度名称和表头完整，行高也较平稳。",
     "problems": "方案B的运维说明同样出现单字孤行；与r2A相比，视觉上没有明显改善。",
     "cause": "方案B列宽333px，比r2A更窄，仍不足以让“配置”完整留在首行；增加给方案A的4px没有带来明显收益。"
    }
   ],
   "done": false,
   "names": [
    "r3A",
    "r3B"
   ]
  }
