   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  },
  "r1": {
   "critique": [
    {
     "design": "r0A",
     "good": "工号、姓名、部门、职级和日期均保持单行，表头完整；职责自然分成最多两行，同一行的信息容易对应。各列紧凑，职责列获得了最多空间。",
     "problems": "部分列宽接近内容的最低需求，视觉上较紧；长职责的两行与短职责的单行交替，行高有所变化，但没有妨碍逐行阅读。",
     "cause": "前五列分别为74、83、98、52、106px，基本按最长单行内容分配；306px的职责列使较长说明换成两行。"
    },
    {
     "design": "r0B",
     "good": "335px的职责列较宽，长职责的换行位置比其他方案稍宽松；工号、姓名和日期仍易于扫描。",
     "problems": "职级表头断成两行，部门名称也分成两行，表头和每条记录都因此变高；部门名称的纵向比较变得费力，而职责列增加的宽度并未减少长职责的行数。",
     "cause": "51px的职级列不足以让表头完整显示；70px的部门列只有49px文本宽度，容不下最长的部门名称。"
    },
    {
     "design": "r0C",
     "good": "表头和身份、部门、职级、日期均完整显示；较宽的前几列带来舒展的留白，行的对应关系清楚。",
     "problems": "前几列的额外留白压缩了职责列，使长说明更早换行，而表格高度和长职责行数与r0A相同。",
     "cause": "工号、姓名、部门、职级和日期列分别比r0A宽4、7、7、4、4px，职责列因此缩至278px。"
    }
   ],
   "done": true,
   "names": [
    "r0A",
    "r0B",
    "r0C"
   ]
  }
 },
